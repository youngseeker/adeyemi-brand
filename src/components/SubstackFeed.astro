---
import { fetchSubstackFeedItems } from '../lib/substack';

// We will replace this URL with your actual Substack RSS link
const feedUrl = 'https://adeyemiadeniji.substack.com/feed';
let posts: any[] = await fetchSubstackFeedItems(feedUrl);
// Keep only the 3 most recent
posts = posts.slice(0, 3);
---

<div class="grid gap-6 md:grid-cols-3">
    {posts.length > 0 ? (
        posts.map((post) => (
            <a href={post.link} target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-gray-200 p-5 transition hover:border-brandBlue dark:border-gray-800">
                <p class="text-[10px] tracking-widest text-brandBlue uppercase">Real Talk Newsletter</p>
                <h4 class="mt-2 text-xl font-bold transition group-hover:text-brandBlue">{post.title}</h4>
                <p class="mt-3 text-xs font-bold tracking-widest text-gray-400 uppercase">
                    {new Date(post.pubDate || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
            </a>
        ))
    ) : (
        <p class="text-gray-500">Loading latest articles...</p>
    )}
</div>