---
// Poll interaction handler - Manages clicking on poll options and submitting votes
// This component injects the client-side script into articles
---

<script>
	type PollState = {
		voted: boolean;
		myVoteIndex: number | null;
		results: { counts: number[]; total: number } | null;
	};

	const pollCache = new Map<string, PollState>();

	const getPollSection = (pollKey: string): HTMLElement | null => {
		return document.querySelector(`[data-poll-key="${pollKey}"]`);
	};

	const getPollButton = (pollKey: string, optionIndex: number): HTMLButtonElement | null => {
		const section = getPollSection(pollKey);
		if (!section) return null;
		return section.querySelector(`[data-poll-vote][data-poll-option-index="${optionIndex}"]`);
	};

	const updatePollUI = async (pollKey: string) => {
		const slug = (document.body.getAttribute('data-slug') || '').trim();
		if (!slug) return;

		const section = getPollSection(pollKey);
		if (!section) return;

		const statusEl = section.querySelector('[data-poll-status]') as HTMLElement;
		const optionsList = section.querySelector('[data-poll-options-list]') as HTMLElement;
		const resultsList = section.querySelector('[data-poll-results]') as HTMLElement;

		// Fetch poll results from API
		try {
			const response = await fetch(`/api/polls?slug=${encodeURIComponent(slug)}`, {
				method: 'GET',
				credentials: 'include',
				headers: { 'cache-control': 'no-cache' },
			});

			if (!response.ok) return;

			const data = (await response.json()) as {
				ok: boolean;
				results?: Array<{ pollKey: string; counts: number[]; total: number; myVoteIndex: number | null }>;
			};

			if (!data.ok || !data.results) return;

			const pollResult = data.results.find((r) => r.pollKey === pollKey);
			if (!pollResult) return;

			const { counts, total, myVoteIndex } = pollResult;

			// Update button states
			const buttons = optionsList?.querySelectorAll('[data-poll-vote]') || [];
			buttons.forEach((btn: Element, idx: number) => {
				const button = btn as HTMLButtonElement;
				button.disabled = true;
				const action = button.querySelector('[data-poll-action-label]');
				if (myVoteIndex === idx) {
					button.setAttribute('aria-pressed', 'true');
					if (action) action.textContent = '✓ Voted';
				} else {
					button.removeAttribute('aria-pressed');
					if (action) action.textContent = '—';
				}
			});

			// Update result view
			const resultRows = resultsList?.querySelectorAll('[data-poll-result-row]') || [];
			resultRows.forEach((row: Element, idx: number) => {
				const count = counts[idx] ?? 0;
				const percent = total > 0 ? ((count / total) * 100).toFixed(0) : '0';
				const label = row.querySelector('[data-poll-result-label]') as HTMLElement;
				const bar = row.querySelector('[data-poll-result-bar]') as HTMLElement;

				if (label) label.textContent = `${percent}%`;
				if (bar) bar.style.width = `${percent}%`;
			});

			// Update status
			if (statusEl) {
				if (myVoteIndex !== null) {
					statusEl.textContent = 'Thank you for voting!';
				} else {
					statusEl.textContent = `${total} vote${total !== 1 ? 's' : ''} cast`;
				}
			}

			pollCache.set(pollKey, { voted: myVoteIndex !== null, myVoteIndex, results: { counts, total } });
		} catch (error) {
			console.error(`[Polls] Error updating poll ${pollKey}:`, error);
			if (statusEl) statusEl.textContent = 'Error loading poll results';
		}
	};

	const castVote = async (pollKey: string, optionIndex: number) => {
		const slug = (document.body.getAttribute('data-slug') || '').trim();
		if (!slug) return;

		const button = getPollButton(pollKey, optionIndex);
		if (!button) return;

		button.disabled = true;

		try {
			const response = await fetch('/api/polls', {
				method: 'POST',
				credentials: 'include',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ slug, pollKey, optionIndex }),
			});

			if (!response.ok) {
				button.disabled = false;
				console.error(`[Polls] Vote failed with status ${response.status}`);
				return;
			}

			// Wait a moment to ensure vote is processed, then refresh UI
			await new Promise((resolve) => setTimeout(resolve, 100));
			await updatePollUI(pollKey);
		} catch (error) {
			button.disabled = false;
			console.error(`[Polls] Error casting vote:`, error);
		}
	};

	const initPollHandlers = () => {
		const polls = document.querySelectorAll('[data-poll-key]');

		polls.forEach((poll: Element) => {
			const pollKey = poll.getAttribute('data-poll-key') ?? '';
			if (!pollKey) return;

			// Load initial results
			updatePollUI(pollKey).catch(console.error);

			// Attach click handlers
			const buttons = poll.querySelectorAll('[data-poll-vote]');
			buttons.forEach((button: Element) => {
				const btn = button as HTMLButtonElement;
				const optionIndex = Number(btn.getAttribute('data-poll-option-index') ?? -1);

				if (optionIndex < 0) return;

				// Remove any existing listeners by cloning (to ensure no double-binding)
				const newBtn = btn.cloneNode(true) as HTMLButtonElement;
				newBtn.addEventListener('click', (event: Event) => {
					event.preventDefault();
					event.stopPropagation();
					castVote(pollKey, optionIndex).catch(console.error);
				});

				btn.replaceWith(newBtn);
			});
		});
	};

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPollHandlers);
	} else {
		initPollHandlers();
	}

	// Periodically refresh results (every 10 seconds) for real-time updates
	const refreshInterval = setInterval(() => {
		const polls = document.querySelectorAll('[data-poll-key]');
		polls.forEach((poll: Element) => {
			const pollKey = poll.getAttribute('data-poll-key') ?? '';
			if (pollKey) {
				updatePollUI(pollKey).catch(console.error);
			}
		});
	}, 10000);

	// Cleanup on page unload
	window.addEventListener('beforeunload', () => {
		clearInterval(refreshInterval);
	});
</script>
