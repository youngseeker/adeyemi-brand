---
import { externalLinks, navigation, site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="site-container site-footer__grid">
        <div class="site-footer__identity">
            <a class="wordmark" href="/">{site.wordmark}</a>
            <p>Computer Science undergraduate building software and writing along the way.</p>
        </div>
        <nav aria-label="Footer navigation">
            <p class="eyebrow">Explore</p>
            <ul>
                {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
        </nav>
        <nav aria-label="External links">
            <p class="eyebrow">Elsewhere</p>
            <ul>
                {externalLinks.map((link) => (
                    <li>
                        <a href={link.href} target={link.kind === 'email' ? undefined : '_blank'} rel={link.kind === 'email' ? undefined : 'noreferrer'}>
                            {link.label}{link.kind !== 'email' && <span aria-hidden="true"> ↗</span>}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
    <div class="site-container site-footer__base">
        <p>© {year} {site.name}</p>
        <p>Based in Nigeria</p>
    </div>
</footer>
