---
const { url } = Astro.props as { url: string };
const iframeId = `preview-${Math.random().toString(36).slice(2, 9)}`;
const toggleId = `toggle-${iframeId}`;
---
<div class="project-preview">
  <div class="mb-3 flex items-center justify-between">
    <a href={url} target="_blank" rel="noreferrer noopener" class="text-sm font-semibold text-brandBlue">Open live site</a>
    <button id={toggleId} type="button" class="ui-btn ui-btn-neutral">Toggle iframe preview</button>
  </div>

  <div class="border border-gray-200 dark:border-gray-800">
    <iframe id={iframeId} src={url} class="w-full h-120" sandbox="" loading="lazy"></iframe>
  </div>

  <p class="mt-2 text-xs text-gray-500">If the iframe is blank the target site prevents embedding; click "Open live site" instead.</p>
</div>

<script define:vars={{ iframeId, toggleId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById(toggleId);
    const iframe = document.getElementById(iframeId);
    if (!toggleBtn || !iframe) return;
    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      iframe.classList.toggle('hidden');
    });
  });
</script>

<style>
.project-preview iframe.hidden { display: none; }
.project-preview iframe { border: 0; }
</style>
