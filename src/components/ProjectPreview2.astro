---
const { url } = Astro.props as { url: string };
const iframeId = `preview-${Math.random().toString(36).slice(2, 9)}`;
const toggleId = `toggle-${iframeId}`;
---
<div class="project-preview group rounded-lg border border-gray-200 bg-white p-5 transition dark:border-gray-800 dark:bg-gray-900 hover:border-brandBlue hover:shadow-md dark:hover:shadow-brandBlue/20">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <svg class="h-5 w-5 text-brandBlue flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
      <a href={url} target="_blank" rel="noreferrer" class="text-sm font-semibold text-brandBlue hover:underline hover:text-brandBlue/80">Visit Site</a>
    </div>
    <button id={toggleId} type="button" class="ui-btn ui-btn-neutral text-xs whitespace-nowrap">Show</button>
  </div>

  <div id={`container-${iframeId}`} class="hidden overflow-hidden rounded-md border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
    <iframe 
      id={iframeId} 
      src={url} 
      title="Project preview"
      class="w-full h-120 border-0" 
      sandbox="allow-same-origin allow-scripts allow-popups allow-forms" 
      loading="lazy">
    </iframe>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
    <span class="font-semibold">📌</span> Click "Show" to preview. If blank, the site blocks embedding—use "Visit Site" instead.
  </p>
</div>

<script is:inline define:vars={{ iframeId, toggleId }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById(toggleId);
    const container = document.getElementById(`container-` + iframeId);
    
    if (toggleBtn && container) {
      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isHidden = container.classList.contains('hidden');
        
        if (isHidden) {
          container.classList.remove('hidden');
          toggleBtn.textContent = 'Hide';
          toggleBtn.classList.add('ui-btn-primary');
          toggleBtn.classList.remove('ui-btn-neutral');
        } else {
          container.classList.add('hidden');
          toggleBtn.textContent = 'Show';
          toggleBtn.classList.remove('ui-btn-primary');
          toggleBtn.classList.add('ui-btn-neutral');
        }
      });
    }
  });
</script>

<style>
  .project-preview {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  
  .dark .project-preview {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }
  
  .project-preview:hover {
    box-shadow: 0 4px 12px rgba(43, 89, 195, 0.1);
  }
</style>
