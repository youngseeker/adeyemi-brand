---
import FeaturedProject from '../components/work/FeaturedProject.astro';
import SupportingProject from '../components/work/SupportingProject.astro';
import WritingCard from '../components/writing/WritingCard.astro';
import WritingEmptyState from '../components/writing/WritingEmptyState.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { activeNowCategories, now } from '../data/now';
import { featuredProjects, supportingProjects } from '../data/projects';
import { configuredWritingSources, writingSources } from '../data/writing';
import { fetchWritingItems } from '../lib/writingFeed';

const writingItems = (await fetchWritingItems(configuredWritingSources)).slice(0, 4);
const featuredWriting = writingItems[0];
const recentWriting = writingItems.slice(1, 4);
---

<SiteLayout canonicalPath="/">
    <section class="hero">
        <div class="site-container hero__grid">
            <div class="hero__content">
                <p class="eyebrow">Computer Science undergraduate · Software builder</p>
                <h1>Adeyemi <em>Adeniji.</em></h1>
                <p class="hero__role">I build software and digital products—and write about what I’m learning.</p>
                <p class="hero__intro">
                    I have built production websites, product experiences, and practical tools. I write externally
                    about people, technology, work, and what I am learning along the way.
                </p>
                <div class="button-row">
                    <ButtonLink href="/work">View my work</ButtonLink>
                    <ButtonLink href="/writing" variant="secondary">Read my writing</ButtonLink>
                </div>
            </div>
            <figure class="hero__portrait">
                <picture>
                    <source srcset="/adeyemi.webp" type="image/webp" />
                    <img src="/adeyemi.jpg" alt="Adeyemi Adeniji" width="852" height="1280" fetchpriority="high" />
                </picture>
                <figcaption><span>Portrait</span><span>Nigeria · 2026</span></figcaption>
            </figure>
        </div>
    </section>

    <section class="page-section selected-work" aria-labelledby="selected-work-heading">
        <div class="site-container">
            <div class="section-heading" data-reveal>
                <div><p class="eyebrow">Selected work</p><h2 id="selected-work-heading">Built work, stated plainly.</h2></div>
                <p>Three related products, with ownership kept distinct and Adeyemi’s contribution made explicit.</p>
            </div>
            <div class="featured-projects">
                {featuredProjects.map((project, index) => <FeaturedProject project={project} index={index} />)}
            </div>

            <div class="supporting-work" aria-labelledby="supporting-work-heading">
                <div class="supporting-work__heading">
                    <h3 id="supporting-work-heading">Other work</h3>
                    <ButtonLink href="/work" variant="text">See all work</ButtonLink>
                </div>
                <div class="supporting-work__list">
                    {supportingProjects.map((project) => <SupportingProject project={project} headingLevel="h4" />)}
                </div>
            </div>
        </div>
    </section>

    <section class="page-section writing-preview-section" aria-labelledby="writing-heading">
        <div class="site-container">
            <div class="section-heading" data-reveal>
                <div><p class="eyebrow">Writing</p><h2 id="writing-heading">Notes from the work of learning.</h2></div>
                <p>Essays and reflections on people, technology, work, and lessons still taking shape.</p>
            </div>
            {featuredWriting ? (
                <div class="writing-preview">
                    <WritingCard item={featuredWriting} featured headingLevel="h3" />
                    {recentWriting.length > 0 && (
                        <div class="writing-preview__recent">
                            {recentWriting.map((item) => <WritingCard item={item} headingLevel="h3" />)}
                        </div>
                    )}
                </div>
            ) : (
                <WritingEmptyState sources={writingSources} />
            )}
            <div class="section-action"><ButtonLink href="/writing" variant="secondary">Explore writing</ButtonLink></div>
        </div>
    </section>

    <section class="page-section about-preview" aria-labelledby="about-heading">
        <div class="site-container about-preview__inner" data-reveal>
            <p class="eyebrow">About</p>
            <h2 id="about-heading">
                A Computer Science undergraduate who builds software, works across digital products, and writes about
                what he’s learning along the way.
            </h2>
            <ButtonLink href="/about" variant="text">More about me</ButtonLink>
        </div>
    </section>

    <section class="page-section now-preview" aria-labelledby="now-heading">
        <div class="site-container">
            <div class="now-preview__heading" data-reveal>
                <div><p class="eyebrow">Now · {now.updatedAt}</p><h2 id="now-heading">Still in motion.</h2></div>
                <ButtonLink href="/now" variant="text">Full update</ButtonLink>
            </div>
            <div class="now-preview__grid">
                {activeNowCategories.map((category) => (
                    <article data-reveal>
                        <h3>{category.label}</h3>
                        <p>{category.items.join(' · ')}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>
</SiteLayout>
