---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';
import '../../styles/article-professional.css';
import Footer from '../../components/Footer.astro';
import PwaHead from '../../components/PwaHead.astro';

// 1. Tell Astro to pre-build these pages despite being in SSR mode
export const prerender = true;

// 2. Generate a page for every file in the devotionals folder
export async function getStaticPaths() {
    const devotionals = await getCollection('devotionals');
    return devotionals.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

// 3. Render the markdown content into HTML
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/aa-logo.svg" />
        <title>{entry.data.title} | Devotionals</title>
        <meta name="robots" content="noindex, follow" />
        <PwaHead />
        <script is:inline>
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    return 'dark';
                }
                return 'light';
            })();
            document.documentElement.classList.toggle('dark', theme !== 'light');
        </script>
    </head>
    <body class="bg-white text-black dark:bg-[#050505] dark:text-white">
        <header class="sticky top-0 z-40 border-b border-gray-200/70 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-[#050505]/90">
            <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
                <a href="/" class="text-sm font-black tracking-widest uppercase">A.ADENIJI</a>
                <div class="hidden items-center gap-6 text-xs font-bold tracking-[0.2em] uppercase md:flex">
                    <a href="/garden" class="transition hover:text-brandBlue">Articles</a>
                    <a href="/devotionals" class="transition hover:text-brandBlue">Devotionals</a>
                    <a href="/about" class="transition hover:text-brandBlue">About</a>
                </div>
                <div class="flex items-center gap-2">
                    <button id="mobileMenuToggle" type="button" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle mobile navigation menu" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-bold tracking-widest uppercase md:hidden dark:border-gray-700">Menu</button>
                    <button id="themeToggle" type="button" aria-label="Toggle theme" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 dark:border-gray-700">
                        <span class="text-xs font-bold uppercase dark:hidden">L</span>
                        <span class="hidden text-xs font-bold uppercase dark:inline">D</span>
                    </button>
                </div>
            </nav>
            <div id="mobileMenu" aria-hidden="true" class="mx-auto hidden max-w-7xl gap-2 border-t border-gray-200 px-6 py-3 text-xs font-bold tracking-[0.2em] uppercase md:hidden dark:border-gray-800">
                <a href="/" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Home</a>
                <a href="/garden" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Articles</a>
                <a href="/devotionals" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Devotionals</a>
                <a href="/about" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">About</a>
            </div>
        </header>

        <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
            <div class="mb-8 flex flex-wrap gap-3 text-xs font-bold tracking-[0.2em] uppercase">
                <a href="/" class="text-brandBlue">Home</a>
                <span class="text-gray-400">/</span>
                <a href="/devotionals" class="text-brandBlue">Devotionals</a>
            </div>

            <header class="mb-10 border-b border-gray-200 pb-10 dark:border-gray-800">
                <p class="mb-2 text-xs tracking-widest text-gray-400 uppercase">{entry.data.scriptureRef || 'Scripture reflection'}</p>
                <h1 class="text-4xl font-bold tracking-tighter uppercase md:text-5xl">{entry.data.title}</h1>
                {entry.data.excerpt && <p class="mt-4 max-w-2xl text-gray-600 dark:text-gray-300">{entry.data.excerpt}</p>}
            </header>

            <article class="article-content max-w-none text-base text-gray-800 dark:text-gray-200">
                <Content />
            </article>
        </main>

        <Footer />

        <script is:inline>
            const themeToggle = document.getElementById('themeToggle');
            themeToggle?.addEventListener('click', () => {
                const root = document.documentElement;
                root.classList.toggle('dark');
                localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
            });
        </script>
    </body>
</html>
