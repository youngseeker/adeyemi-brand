---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

// 1. Tell Astro to pre-build these pages despite being in SSR mode
export const prerender = true;

// 2. Generate a page for every file in the devotionals folder
export async function getStaticPaths() {
    const devotionals = await getCollection('devotionals');
    return devotionals.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

// 3. Render the markdown content into HTML
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<html lang="en">
    <head>
        <title>{entry.data.title} | Devotionals</title>
    </head>
    <body class="bg-white text-black dark:bg-[#050505] dark:text-white">
        <main class="mx-auto max-w-3xl px-6 py-20">
            <a href="/devotionals" class="mb-8 inline-block text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">&larr; All Devotionals</a>
            
            <header class="mb-10 border-b border-gray-200 pb-10 dark:border-gray-800">
                <p class="mb-2 text-xs tracking-widest text-gray-400 uppercase">{entry.data.scriptureRef}</p>
                <h1 class="text-4xl font-bold tracking-tighter uppercase md:text-5xl">{entry.data.title}</h1>
            </header>
            
            <article class="prose max-w-none dark:prose-invert">
                <Content />
            </article>
        </main>
    </body>
</html>