---
import '../styles/global.css';

const inferredVercelRepo = import.meta.env.VERCEL_GIT_REPO_OWNER && import.meta.env.VERCEL_GIT_REPO_SLUG
	? `${import.meta.env.VERCEL_GIT_REPO_OWNER}/${import.meta.env.VERCEL_GIT_REPO_SLUG}`
	: '';
const keystaticRepo = import.meta.env.KEYSTATIC_GITHUB_REPO || inferredVercelRepo || 'youngseeker/afraid-antimatter';
const isProduction = import.meta.env.PROD;
const hasKeystaticRepo = Boolean(keystaticRepo && keystaticRepo.includes('/'));
const hasKeystaticSecret = typeof import.meta.env.KEYSTATIC_SECRET === 'string' && import.meta.env.KEYSTATIC_SECRET.length >= 32;
const hasKeystaticGithubClientId = Boolean(import.meta.env.KEYSTATIC_GITHUB_CLIENT_ID);
const hasKeystaticGithubClientSecret = Boolean(import.meta.env.KEYSTATIC_GITHUB_CLIENT_SECRET);
const missingKeystaticEnvVars = [
	!hasKeystaticRepo ? 'KEYSTATIC_GITHUB_REPO (owner/repo)' : '',
	!hasKeystaticSecret ? 'KEYSTATIC_SECRET (min 32 chars)' : '',
	!hasKeystaticGithubClientId ? 'KEYSTATIC_GITHUB_CLIENT_ID' : '',
	!hasKeystaticGithubClientSecret ? 'KEYSTATIC_GITHUB_CLIENT_SECRET' : '',
].filter(Boolean);
const keystaticGithubWriteReady = !isProduction || missingKeystaticEnvVars.length === 0;

const steps = [
	{
		title: 'Open The Editor',
		detail: 'Go to /keystatic, then open Posts and click Create entry.',
	},
	{
		title: 'Fill The Required Fields',
		detail: 'Add Title, Excerpt, Publish Date, Author, and Tags before writing the full body.',
	},
	{
		title: 'Write In Sections',
		detail: 'Use clear headings and short paragraphs. Treat each section as a single idea.',
	},
	{
		title: 'Choose Strong Tags',
		detail: 'Use tags like algorithms, systems-design, pwa, ai-ethics, human-logic.',
	},
	{
		title: 'Save And Verify',
		detail: 'Save in Keystatic, then open /garden to confirm your article appears correctly.',
	},
	{
		title: 'Preview Drafts Securely',
		detail: 'While logged in to admin, open /garden/your-slug?preview=1 to preview drafts and scheduled posts before they go live.',
	},
	{
		title: 'Share And Measure',
		detail: 'Share the article URL and review engagement in /admin/insights.',
	},
];

const advancedTopics = [
	'Algorithmic Fairness in Constraint-Based Decision Systems',
	'Designing Explainable State Machines for Human-Centered Products',
	'Formal Specification as a Bridge Between Product and Engineering',
	'Latency, Cognition, and Trust in Progressive Web Applications',
	'Ethical Failure Modes in Multi-Agent Workflows',
	'Technical Writing as Infrastructure: Building Reusable Reasoning Layers',
	'Consistency Models for Reflection-Driven User Interfaces',
	'Human Logic Compression: From Narrative to Executable Rules',
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Publishing Guide | Adeyemi Adeniji</title>
		<meta name="description" content="Step-by-step guide for publishing articles on your site with advanced CS-focused writing topics." />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&family=Playfair+Display:ital,wght@0,400;1,700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-white font-['Space_Grotesk'] text-black dark:bg-[#050505] dark:text-white">
		<main class="mx-auto max-w-5xl px-6 py-16">
			<div class="flex items-center justify-between gap-4">
				<a href="/" class="text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">Back Home</a>
				<div class="flex items-center gap-2">
					<a href="/keystatic" class="rounded-full bg-brandBlue px-5 py-2 text-xs font-bold tracking-widest text-white uppercase">Open Keystatic</a>
					<button id="themeToggle" type="button" aria-label="Toggle theme" class="rounded-full border border-gray-300 px-4 py-2 text-xs font-bold tracking-widest uppercase dark:border-gray-700">Theme</button>
				</div>
			</div>

			<h1 class="mt-8 text-5xl font-bold tracking-tight uppercase">How To Publish</h1>
			<p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
				This page is your workflow. Follow these steps each time you want to publish a new article.
			</p>

			<section class="mt-12 grid gap-4 md:grid-cols-2">
				{steps.map((step, index) => (
					<article class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
						<p class="text-xs font-bold tracking-widest text-brandBlue uppercase">Step {index + 1}</p>
						<h2 class="mt-2 text-xl font-bold">{step.title}</h2>
						<p class="mt-2 text-gray-600 dark:text-gray-300">{step.detail}</p>
					</article>
				))}
			</section>

			<section class="mt-12 rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
				<h2 class="text-2xl font-bold uppercase">Advanced Topic Bank</h2>
				<p class="mt-2 text-gray-600 dark:text-gray-300">
					Use these as article starting points. Pick one, then write your own argument and examples.
				</p>
				<ul class="mt-5 space-y-2 border-l border-brandBlue/30 pl-4">
					{advancedTopics.map((topic) => (
						<li class="text-sm text-gray-700 dark:text-gray-200">• {topic}</li>
					))}
				</ul>
			</section>

			<section class="mt-12 rounded-2xl border-2 border-brandBlue p-6">
				<h2 class="text-xl font-bold uppercase">Quick Posting Checklist</h2>
				<p class="mt-3 text-sm text-gray-600 dark:text-gray-300">Before you close the editor, confirm:</p>
				<ul class="mt-4 space-y-2 text-sm">
					<li>• Title is clear and specific</li>
					<li>• Excerpt explains the argument in one sentence</li>
					<li>• Tags are relevant and searchable</li>
					<li>• Body has heading structure and examples</li>
					<li>• For drafts/scheduled posts, preview with /garden/your-slug?preview=1 while logged in</li>
					<li>• For public visibility, ensure status is Published (or scheduled time has passed)</li>
					<li>• Live site refreshes after a new deployment from your Keystatic commit</li>
				</ul>
			</section>

			<section class="mt-8 rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
				<h2 class="text-xl font-bold uppercase">Instant Preview Link</h2>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
					Paste your article slug (or title) and open secure preview in one click.
				</p>
				<div class="mt-4 flex flex-col gap-3 sm:flex-row">
					<input
						id="previewSlugInput"
						type="text"
						placeholder="e.g. freedom-without-limits"
						class="w-full rounded-xl border border-gray-300 bg-transparent px-4 py-3 text-sm dark:border-gray-700"
					/>
					<button id="openPreviewButton" type="button" class="rounded-xl bg-brandBlue px-4 py-3 text-xs font-bold tracking-widest text-white uppercase">
						Open Preview
					</button>
				</div>
				<p id="previewStatus" class="mt-3 text-sm text-gray-500 dark:text-gray-300"></p>
			</section>

			<section class="mt-8 rounded-2xl border p-6 dark:border-gray-800" class:list={{ 'border-emerald-300 bg-emerald-50/60 dark:border-emerald-800 dark:bg-emerald-950/20': keystaticGithubWriteReady, 'border-rose-300 bg-rose-50/60 dark:border-rose-800 dark:bg-rose-950/20': !keystaticGithubWriteReady }}>
				<h2 class="text-xl font-bold uppercase">Keystatic GitHub Commit Health</h2>
				<p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
					Status: <strong>{keystaticGithubWriteReady ? 'Ready for GitHub commits' : 'Not ready for GitHub commits'}</strong>
				</p>
				<p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
					Detected repo: {keystaticRepo || 'not set'}
				</p>
				{isProduction && missingKeystaticEnvVars.length > 0 && (
					<div class="mt-4">
						<p class="text-sm font-bold">Missing/invalid production variables:</p>
						<ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300">
							{missingKeystaticEnvVars.map((item) => (
								<li>• {item}</li>
							))}
						</ul>
					</div>
				)}
				<p class="mt-4 text-xs text-gray-600 dark:text-gray-400">
					If commits still fail after env setup, confirm your GitHub OAuth app callback URL is set to
					<strong> /api/keystatic/github/oauth/callback</strong> on your site domain and that the OAuth app has repo write access.
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<button id="runCmsHealth" type="button" class="ui-btn ui-btn-neutral">Run Live CMS Health Check</button>
					<p id="cmsHealthStatus" class="text-sm text-gray-600 dark:text-gray-300"></p>
				</div>
				<div id="cmsHealthResults" class="mt-4 space-y-2"></div>
			</section>
		</main>
		<script is:inline>
			const themeToggle = document.getElementById('themeToggle');
			themeToggle?.addEventListener('click', () => {
				const root = document.documentElement;
				root.classList.toggle('dark');
				localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
			});

			const slugInput = document.getElementById('previewSlugInput');
			const openPreviewButton = document.getElementById('openPreviewButton');
			const previewStatus = document.getElementById('previewStatus');
			const runCmsHealthButton = document.getElementById('runCmsHealth');
			const cmsHealthStatus = document.getElementById('cmsHealthStatus');
			const cmsHealthResults = document.getElementById('cmsHealthResults');

			const normalizeToSlug = (value) => {
				const trimmed = String(value || '').trim();
				if (!trimmed) return '';

				if (trimmed.includes('/garden/')) {
					const match = trimmed.match(/\/garden\/([^?#/]+)/i);
					if (match?.[1]) return match[1].toLowerCase();
				}

				return trimmed
					.toLowerCase()
					.replace(/[^a-z0-9\s-]/g, '')
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-')
					.replace(/^-|-$/g, '');
			};

			const openPreview = () => {
				const rawValue = slugInput instanceof HTMLInputElement ? slugInput.value : '';
				const slug = normalizeToSlug(rawValue);
				if (!slug) {
					if (previewStatus) previewStatus.textContent = 'Enter a valid slug or title first.';
					return;
				}

				const previewUrl = `/garden/${slug}?preview=1`;
				if (previewStatus) previewStatus.textContent = `Opening ${previewUrl}`;
				window.location.href = previewUrl;
			};

			openPreviewButton?.addEventListener('click', openPreview);
			slugInput?.addEventListener('keydown', (event) => {
				if (event.key === 'Enter') {
					event.preventDefault();
					openPreview();
				}
			});

			const renderHealthChecks = (payload) => {
				if (!cmsHealthResults) return;
				const checks = Array.isArray(payload?.checks) ? payload.checks : [];
				if (checks.length === 0) {
					cmsHealthResults.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400">No health checks were returned.</p>';
					return;
				}

				cmsHealthResults.innerHTML = checks
					.map((check) => {
						const ok = Boolean(check?.ok);
						const label = String(check?.label || 'Check');
						const detail = String(check?.detail || '');
						const itemClass = ok
							? 'border-emerald-200 bg-emerald-50 dark:border-emerald-800 dark:bg-emerald-950/30'
							: 'border-rose-200 bg-rose-50 dark:border-rose-800 dark:bg-rose-950/30';
						const badgeClass = ok
							? 'text-emerald-700 dark:text-emerald-300'
							: 'text-rose-700 dark:text-rose-300';

						return `<article class="rounded-xl border px-3 py-2 ${itemClass}"><p class="text-sm font-bold ${badgeClass}">${ok ? 'PASS' : 'FAIL'} · ${label}</p><p class="mt-1 text-xs text-gray-700 dark:text-gray-300">${detail}</p></article>`;
					})
					.join('');
			};

			const runCmsHealthCheck = async () => {
				if (cmsHealthStatus) cmsHealthStatus.textContent = 'Checking CMS health...';
				try {
					const response = await fetch('/api/admin/cms-health', {
						method: 'GET',
						headers: { accept: 'application/json' },
					});
					const payload = await response.json();
					if (!response.ok) {
						throw new Error(payload?.error || 'Unable to run CMS health check.');
					}

					renderHealthChecks(payload);
					if (cmsHealthStatus) {
						cmsHealthStatus.textContent = payload?.isReady
							? 'CMS is ready for GitHub commits.'
							: 'CMS is not fully ready. Resolve the failing checks below.';
					}
				} catch (error) {
					if (cmsHealthStatus) {
						cmsHealthStatus.textContent = error instanceof Error ? error.message : 'CMS health check failed.';
					}
				}
			};

			runCmsHealthButton?.addEventListener('click', runCmsHealthCheck);
			runCmsHealthCheck();
		</script>
	</body>
</html>
