---
import '../../styles/global.css';

const cards = [
	{
		title: 'Publish Articles',
		description: 'Open Keystatic CMS to create and edit posts.',
		href: '/keystatic',
		label: 'CMS',
	},
	{
		title: 'Publishing Guide',
		description: 'Step-by-step workflow and advanced topic bank.',
		href: '/publish',
		label: 'Guide',
	},
	{
		title: 'Insights Console',
		description: 'Moderate reviews and monitor engagement analytics.',
		href: '/admin/insights',
		label: 'Analytics',
	},
	{
		title: 'Public Articles',
		description: 'Preview how readers see your published writing.',
		href: '/garden',
		label: 'Preview',
	},
	{
		title: 'QA Console',
		description: 'Run visual and interaction checks before deployment.',
		href: '/qa',
		label: 'Quality',
	},
];

const postChecklist = [
	'Open /keystatic and create a new post.',
	'Add title, excerpt, date, author, and clear tags.',
	'Write content with section headings and examples.',
	'Save, then verify visibility on /garden and /garden/[slug].',
	'Run /qa checklist and confirm key mobile/desktop interactions.',
	'Check /admin/insights to monitor engagement trends.',
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Admin Hub | A.ADENIJI</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-white font-['Space_Grotesk'] text-black dark:bg-[#050505] dark:text-white">
		<main class="mx-auto max-w-5xl px-6 py-16">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<a href="/" class="text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">Back Home</a>
				<div class="flex items-center gap-2">
					<button id="themeToggle" type="button" aria-label="Toggle theme" class="rounded-lg border border-gray-300 px-3 py-2 text-xs font-bold tracking-widest uppercase dark:border-gray-700">Theme</button>
					<button id="logoutButton" type="button" class="rounded-lg border border-red-300 px-3 py-2 text-xs font-bold tracking-widest uppercase text-red-600 dark:border-red-800 dark:text-red-400">Logout</button>
				</div>
			</div>

			<h1 class="mt-8 text-4xl font-bold uppercase">Admin Hub</h1>
			<p class="mt-2 text-gray-500 dark:text-gray-300">Your control center for publishing, moderation, and performance review.</p>

			<section class="mt-8 grid gap-3 md:grid-cols-4">
				<div class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
					<p class="text-[10px] tracking-widest text-gray-400 uppercase">Total Views</p>
					<p id="kpiViews" class="mt-2 text-2xl font-bold">--</p>
				</div>
				<div class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
					<p class="text-[10px] tracking-widest text-gray-400 uppercase">Approved Reviews</p>
					<p id="kpiApproved" class="mt-2 text-2xl font-bold">--</p>
				</div>
				<div class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
					<p class="text-[10px] tracking-widest text-gray-400 uppercase">Pending Reviews</p>
					<p id="kpiPending" class="mt-2 text-2xl font-bold">--</p>
				</div>
				<div class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
					<p class="text-[10px] tracking-widest text-gray-400 uppercase">System Uptime</p>
					<p id="kpiUptime" class="mt-2 text-sm font-bold">--</p>
				</div>
			</section>

			<section class="mt-10 grid gap-4 md:grid-cols-2">
				{cards.map((card) => (
					<a href={card.href} data-astro-prefetch={card.href === '/keystatic' ? 'false' : undefined} class="rounded-2xl border border-gray-200 p-6 transition hover:border-brandBlue dark:border-gray-800">
						<p class="text-[10px] tracking-widest text-gray-400 uppercase">{card.label}</p>
						<h2 class="mt-2 text-2xl font-bold">{card.title}</h2>
						<p class="mt-3 text-gray-600 dark:text-gray-300">{card.description}</p>
					</a>
				))}
			</section>

			<section class="mt-10 rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
				<h2 class="text-xl font-bold uppercase">Posting Workflow</h2>
				<p class="mt-2 text-sm text-gray-500 dark:text-gray-300">Use this checklist whenever you publish a new article.</p>
				<ul class="mt-4 space-y-2 border-l border-brandBlue/30 pl-4">
					{postChecklist.map((item) => (
						<li class="text-sm text-gray-700 dark:text-gray-200">• {item}</li>
					))}
				</ul>
			</section>
		</main>

		<script is:inline>
			const themeToggle = document.getElementById('themeToggle');
			const logoutButton = document.getElementById('logoutButton');
			const kpiViews = document.getElementById('kpiViews');
			const kpiApproved = document.getElementById('kpiApproved');
			const kpiPending = document.getElementById('kpiPending');
			const kpiUptime = document.getElementById('kpiUptime');
			themeToggle?.addEventListener('click', () => {
				const root = document.documentElement;
				root.classList.toggle('dark');
				localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
			});

			logoutButton?.addEventListener('click', async () => {
				await fetch('/api/admin/logout', { method: 'POST' });
				window.location.href = '/admin/login';
			});

			const loadSnapshot = async () => {
				try {
					const [analyticsResponse, statusResponse] = await Promise.all([
						fetch('/api/analytics'),
						fetch('/api/status.json'),
					]);

					if (analyticsResponse.ok) {
						const analytics = await analyticsResponse.json();
						if (kpiViews) kpiViews.textContent = String(analytics.totalViews || 0);
						if (kpiApproved) kpiApproved.textContent = String(analytics.approvedFeedbackCount || 0);
						if (kpiPending) kpiPending.textContent = String(analytics.pendingFeedbackCount || 0);
					}

					if (statusResponse.ok) {
						const status = await statusResponse.json();
						const uptimeSeconds = Number(status.uptimeSeconds || 0);
						const hours = Math.floor(uptimeSeconds / 3600);
						const minutes = Math.floor((uptimeSeconds % 3600) / 60);
						if (kpiUptime) kpiUptime.textContent = `${hours}h ${minutes}m`;
					}
				} catch {
					if (kpiUptime) kpiUptime.textContent = 'Unavailable';
				}
			};

			loadSnapshot();
		</script>
	</body>
</html>
