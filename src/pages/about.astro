---
import ButtonLink from '../components/ui/ButtonLink.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { externalLinks } from '../data/site';
---

<SiteLayout title="About" description="About Adeyemi Adeniji, a Computer Science undergraduate building software and writing along the way." canonicalPath="/about">
    <header class="page-intro">
        <div class="site-container page-intro__grid">
            <div><p class="eyebrow">About · The short version</p><h1>Building before the story is finished.</h1></div>
            <p class="page-intro__lead">I’m Adeyemi Adeniji, a Computer Science undergraduate learning in public through software, production work, and writing.</p>
        </div>
    </header>

    <section class="page-section">
        <div class="site-container split-grid">
            <div class="prose" data-reveal>
                <h2>Curiosity, made practical.</h2>
                <p>I study Computer Science at the National Open University of Nigeria. Alongside that education, I build software products, improve websites, and contribute to digital work where technical choices need to remain understandable to the people using them.</p>
                <p>My writing follows the same curiosity. I write about people, technology, work, attention, and the ideas I am testing as I learn.</p>
                <p>I value clear problem definitions, maintainable work, careful communication, and honest evidence. This site is a record of that work in progress, not a claim that the learning is finished.</p>
            </div>
            <dl class="fact-list" data-reveal>
                <div><dt>Education</dt><dd>BSc Computer Science, National Open University of Nigeria</dd></div>
                <div><dt>Background</dt><dd>Software products, website management, product implementation, and technical communication</dd></div>
                <div><dt>Writing</dt><dd>People, technology, work, and lessons from learning</dd></div>
                <div><dt>Approach</dt><dd>Clear scope, useful evidence, responsible decisions, and maintainable delivery</dd></div>
            </dl>
        </div>
    </section>

    <section class="page-section page-section--compact">
        <div class="site-container split-grid" data-reveal>
            <div class="prose"><p class="eyebrow">Continue</p><h2>Work, writing, and current focus.</h2></div>
            <div>
                <div class="button-row">
                    <ButtonLink href="/work">View work</ButtonLink>
                    <ButtonLink href="/writing" variant="secondary">Read writing</ButtonLink>
                </div>
                <div class="button-row">
                    {externalLinks.map((link) => <ButtonLink href={link.href} variant="text" external={link.kind !== 'email'}>{link.label}</ButtonLink>)}
                </div>
            </div>
        </div>
    </section>
</SiteLayout>
