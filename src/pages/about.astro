---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const profileImage = '/adeyemi.jpg';
const linktreeUrl = 'https://linktr.ee/_adeyemiadeniji';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>About | Adeyemi Adeniji</title>
		<meta name="description" content="About Adeyemi Adeniji: computer science builder, technical writer, and systems thinker." />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&family=Playfair+Display:ital,wght@0,400;1,700&display=swap" rel="stylesheet" />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-white text-black dark:bg-[#050505] dark:text-white">
		<nav class="mx-auto flex max-w-6xl items-center justify-between border-b border-gray-100 px-6 py-6 dark:border-gray-900">
			<a href="/" class="text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">A.ADENIJI</a>
			<div class="hidden items-center gap-6 text-[10px] font-bold tracking-[0.25em] uppercase md:flex">
				<a href="/" class="transition hover:text-brandBlue">Home</a>
				<a href="/work" class="transition hover:text-brandBlue">Work</a>
				<a href="/garden" class="transition hover:text-brandBlue">Articles</a>
				<a href="/devotionals" class="transition hover:text-brandBlue">Devotionals</a>
				<a href="/about" class="transition hover:text-brandBlue">About</a>
			</div>
			<div class="flex items-center gap-2">
				<button id="mobileMenuToggle" type="button" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle mobile navigation menu" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-bold tracking-widest uppercase md:hidden dark:border-gray-700">Menu</button>
				<button id="themeToggle" type="button" aria-label="Toggle theme" class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 dark:border-gray-700">
					<span class="text-xs font-bold uppercase dark:hidden">L</span>
					<span class="hidden text-xs font-bold uppercase dark:inline">D</span>
				</button>
			</div>
		</nav>
		<div id="mobileMenu" aria-hidden="true" class="mx-auto hidden max-w-350 gap-2 border-t border-gray-200 px-6 py-3 text-xs font-bold tracking-[0.2em] uppercase md:hidden dark:border-gray-800">
			<a href="/work" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Work</a>
			<a href="/garden" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Articles</a>
			<a href="/devotionals" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Devotionals</a>
			<a href="/about" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">About</a>
		</div>
		<main class="mx-auto max-w-6xl px-6 py-14">
			<a href="/" class="text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">Back Home</a>
			<div class="mt-8 grid gap-10 border-t border-gray-200 pt-10 lg:grid-cols-[340px_minmax(0,1fr)] lg:items-start dark:border-gray-800">
				<img src={profileImage} alt="Adeyemi Adeniji portrait" class="h-105 w-full border border-gray-200 object-cover dark:border-gray-800" />
				<div>
					<p class="text-xs font-bold tracking-[0.25em] text-brandBlue uppercase">About</p>
					<h1 class="mt-3 text-5xl font-bold leading-tight tracking-tight uppercase md:text-6xl">Adeyemi Adeniji</h1>
					<section class="mt-6 space-y-4">
						<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">I started as a curious problem solver who loved pulling apart systems to see how they worked. Over the years, that curiosity turned into a discipline: studying the mechanics of software while learning how to communicate complex ideas clearly. That combination—building structures and explaining them—became the thread that ties my work together.</p>
						<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">Today, I work at the intersection of human development, structured systems, and ethical technology. As a Reflective Model Translation Partner at RILayer, I help translate human coaching and reflective models into structured representations for digital systems. My focus isn't just on the code; it’s on preserving conceptual clarity, ethical intent, and practical boundaries when human frameworks meet digital environments.</p>
						<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">To ground this work technically, I am studying Computer Science at the National Open University of Nigeria. This strengthens my foundation in algorithms, databases, and software engineering, allowing me to better bridge the gap between human judgment and system logic.</p>
						<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">In the near future, my focus is on building SCOPE (scope.samsoyombo.com). SCOPE is a reflective articulation workspace designed to help you turn unclear thoughts, pressure, or rough experiences into structured understanding. It acts as a lightweight platform for shared product thinking, helping small teams capture design intent and learn from experiments without losing clarity.</p>
						<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">What makes my work different is my approach to operational clarity. I value discipline, ethical responsibility, and long-term impact over hype or shortcuts. I translate human reasoning into system constraints and prefer minimal, testable changes that improve understanding for everyone involved.</p>
					</section>
					<section class="mt-8">
						<p class="text-xs font-bold tracking-widest text-gray-400 uppercase">Timeline & Highlights</p>
						<ol class="mt-4 space-y-4 text-sm text-gray-700 dark:text-gray-300">
							<li>
								<strong>2026</strong> — Focused on authoring long-form technical essays, writing The Thinking That Works, and building the SCOPE platform.
							</li>
							<li>
								<strong>2024–Present</strong> — Reflective Model Translation Partner at RILayer. Translating coaching and reflective development models into structured representations for system use.
							</li>
							<li>
								<strong>2023–Present</strong> — Technical & Soft Skill Collaborator at SamSoyombo Career Pathways Ltd. Supporting online initiatives, systems thinking, and structured documentation.
							</li>
							<li>
								<strong>Ongoing</strong> — Pursuing a B.Sc. in Computer Science, while mentoring, teaching, and publishing field notes on systems thinking and personal growth.
							</li>
						</ol>
					</section>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={linktreeUrl} target="_blank" rel="noreferrer" class="ui-btn ui-btn-neutral">Linktree</a>
						<a href="https://www.linkedin.com/in/adeyemi-adeniji-828204253/" target="_blank" rel="noreferrer" class="ui-btn ui-btn-neutral">LinkedIn</a>
						<a href="mailto:danieladeniji001@gmail.com" class="ui-btn ui-btn-primary">Email</a>
					</div>
					<p class="mt-4 text-sm text-gray-600 dark:text-gray-300">Direct email: <a href="mailto:danieladeniji001@gmail.com" class="font-semibold text-brandBlue underline underline-offset-4">danieladeniji001@gmail.com</a></p>
				</div>
			</div>
		</main>
		<div class="mobile-contact-chip md:hidden">
			<a href="mailto:danieladeniji001@gmail.com" class="ui-btn ui-btn-primary">Email</a>
			<a href={linktreeUrl} target="_blank" rel="noreferrer" class="ui-btn ui-btn-neutral">Linktree</a>
		</div>

		<Footer />
		<script is:inline>
			const themeToggle = document.getElementById('themeToggle');
			const initRevealAnimations = () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion) return;
				const revealTargets = Array.from(document.querySelectorAll('main > *, .rounded-2xl, img'));
				revealTargets.forEach((node) => node.classList.add('reveal-up'));
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
				);
				revealTargets.forEach((node) => observer.observe(node));
			};
			if (themeToggle) {
				themeToggle.addEventListener('click', () => {
					const root = document.documentElement;
					root.classList.toggle('dark');
					localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
				});
			}
			initRevealAnimations();
		</script>
	</body>
</html>
