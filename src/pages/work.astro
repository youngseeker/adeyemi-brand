---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import ProjectPreview from '../components/ProjectPreview.astro';

interface ExperienceItem {
	role: string;
	org: string;
	location: string;
	period: string;
	highlights: string[];
	tags: string[];
	current?: boolean;
}

const experiences: ExperienceItem[] = [
	{
		role: 'Reflective Model Translation Partner',
		org: 'RILayer (formerly MaxME Solutions)',
		location: 'Scotland, United Kingdom',
		period: 'March 2024 - Present',
		current: true,
		highlights: [
			'Translate human coaching and reflective development models into structured digital systems',
			'Contribute to model clarity, terminology consistency, and ethical boundary definition',
			'Work alongside founder to preserve intent during digital representation',
			'Maintain separation between human judgment, coaching, and system support',
			'Participate in technical implementation reviews',
		],
		tags: ['systems-design', 'ethics', 'model-translation', 'human-centered'],
	},
	{
		role: 'Junior and Intermediate Adviser',
		org: 'ROYAL AMBASSADORS OF NIGERIA',
		location: 'Ibadan, Nigeria',
		period: 'January 2025 - Present',
		highlights: [
			'Mentor and guide younger community members',
			'Develop organisational and leadership frameworks',
			'Facilitate structured learning programs',
		],
		tags: ['leadership', 'mentoring', 'community'],
	},
	{
		role: 'Technical & Soft Skill Collaborator',
		org: 'SamSoyombo Career Pathways Ltd',
		location: 'Scotland, United Kingdom',
		period: 'April 2023 - Present',
		highlights: [
			'Support online initiatives through structured collaboration',
			'Work within distributed teams on systems thinking and documentation',
			'Develop communication discipline and follow-through protocols',
			'Contribute to model documentation and structured knowledge work',
		],
		tags: ['systems-thinking', 'documentation', 'collaboration'],
	},
	{
		role: 'Junior and Intermediate President',
		org: 'ROYAL AMBASSADORS OF NIGERIA',
		location: 'Ibadan, Nigeria',
		period: 'October 2022 - December 2024',
		highlights: [
			'Led community service and environmental awareness initiatives',
			'Organized outreach programs and sensitization campaigns',
			'Developed leadership and responsibility across membership',
			'Managed organizational structure and member engagement',
		],
		tags: ['leadership', 'community-service', 'organization'],
	},
	{
		role: 'Campus Ambassador',
		org: 'Cowrywise',
		location: 'Nigeria',
		period: 'December 2025 - Present',
		highlights: [
			'Promote financial literacy and structured savings practices',
			'Engage campus community on responsibility and long-term thinking',
		],
		tags: ['advocacy', 'education', 'responsibility'],
	},
];

const education = [
	{
		institution: 'National Open University of Nigeria (NOUN)',
		degree: 'Bachelor of Science - Computer Science',
		period: '2024 - 2028',
		focus: 'Programming foundations, algorithms, data structures, database systems, software engineering',
	},
	{
		institution: 'Aspire Institute',
		program: 'Organizational Leadership',
		period: 'August - October 2025',
	},
];

const skills = [
	'Progressive Web Applications (PWAs)',
	'Systems Design & Architecture',
	'Model Translation & Representation',
	'Ethical Thinking & Responsibility',
	'Leadership & Community Building',
	'Communication & Documentation',
	'Human-Centered Design',
	'AI Ethics',
];

const projects = [
	{
		title: 'Personal Knowledge & Publishing Platform',
		summary:
			'Astro + Keystatic content system with article routing, tag metadata, and CMS-based publishing workflow.',
		stack: ['Astro', 'Keystatic', 'TypeScript', 'Tailwind'],
		outcome: 'Created a writable digital garden with structured authoring and faster publishing cycles.',
		liveUrl: 'https://my-student-os.vercel.app/',
	},
	{
		title: 'Feedback Moderation + Engagement Analytics Engine',
		summary:
			'Built moderation APIs, anti-spam controls, and trend analytics with persistent data handling.',
		stack: ['Node', 'Drizzle ORM', 'Neon Postgres', 'API Design'],
		outcome: 'Enabled safe community feedback and measurable content performance insights.',
		liveUrl: 'https://athalia-website.vercel.app/',
	},
	{
		title: 'Command-Driven UX Layer',
		summary:
			'Implemented command palette interaction model and system status instrumentation to improve navigation and perception of reliability.',
		stack: ['JavaScript', 'UX Architecture', 'Event Design'],
		outcome: 'Reduced navigation friction and improved user orientation across key site actions.',
		liveUrl: 'https://rilayer.com/',
	},
];

const writingCapabilities = [
	'Converting abstract concepts into implementation-ready specifications',
	'Designing terminology systems for cross-functional clarity',
	'Documenting trade-offs and constraints for long-term maintainability',
	'Writing architecture narratives that align technical and human intent',
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Work & Experience | Adeyemi Adeniji</title>
		<meta name="description" content="Experience in Reflective Model Translation, systems design, leadership, and human-centered development." />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&family=Playfair+Display:ital,wght@0,400;1,700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-white font-['Space_Grotesk'] text-black dark:bg-[#050505] dark:text-white">
		<nav class="mx-auto flex max-w-350 items-baseline justify-between border-b border-gray-100 p-8 dark:border-gray-900">
			<a href="/" class="text-xs font-bold tracking-[0.2em] text-brandBlue uppercase">A.ADENIJI</a>
			<div class="flex items-center gap-6">
				<div class="hidden gap-8 text-[10px] font-bold tracking-[0.3em] uppercase md:flex">
					<a href="/" class="transition hover:text-brandBlue">Home</a>
					<a href="/work" class="transition hover:text-brandBlue">Work</a>
					<a href="/garden" class="transition hover:text-brandBlue">Articles</a>
					<a href="/about" class="transition hover:text-brandBlue">About</a>
				</div>
				<button id="mobileMenuToggle" type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-bold tracking-widest uppercase md:hidden dark:border-gray-700">Menu</button>
				<button
					id="themeToggle"
					type="button"
					aria-label="Toggle theme"
					class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 dark:border-gray-800"
				>
					<span class="text-xs font-bold uppercase dark:hidden">L</span>
					<span class="hidden text-xs font-bold uppercase dark:inline">D</span>
				</button>
			</div>
		</nav>
		<div id="mobileMenu" class="mx-auto hidden max-w-350 gap-2 border-b border-gray-100 px-8 pb-4 text-xs font-bold tracking-[0.2em] uppercase md:hidden dark:border-gray-900">
			<a href="/" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Home</a>
			<a href="/garden" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Articles</a>
		</div>

		<main class="mx-auto max-w-6xl px-6 py-14">
			<section class="border-b border-gray-200 pb-10 dark:border-gray-800">
				<p class="text-xs font-bold tracking-[0.28em] text-brandBlue uppercase">Work</p>
				<h1 class="mt-3 max-w-4xl text-5xl font-bold leading-tight tracking-tight uppercase md:text-7xl">Systems work with clear proof.</h1>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
					Computer Science growth through implementation, technical communication, model translation, and leadership practice.
				</p>
			</section>

			<div class="grid gap-12 py-14 lg:grid-cols-[280px_minmax(0,1fr)]">
				<aside class="lg:sticky lg:top-24 lg:h-fit">
					<div class="border-l-2 border-brandBlue pl-5">
						<p class="text-xs font-bold tracking-[0.22em] text-gray-400 uppercase">Primary Focus</p>
						<p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
							Reliable software systems, explicit reasoning, ethical boundaries, and human-readable technical writing.
						</p>
					</div>
					<div class="mt-8 grid gap-3">
						<a href="#experience" class="text-sm font-bold text-gray-500 transition hover:text-brandBlue">Experience</a>
						<a href="#projects" class="text-sm font-bold text-gray-500 transition hover:text-brandBlue">Projects</a>
						<a href="#capabilities" class="text-sm font-bold text-gray-500 transition hover:text-brandBlue">Capabilities</a>
						<a href="#education" class="text-sm font-bold text-gray-500 transition hover:text-brandBlue">Education</a>
					</div>
				</aside>

				<div class="space-y-16">
					<section id="experience">
						<div class="mb-8 flex items-end justify-between gap-4 border-b border-gray-200 pb-4 dark:border-gray-800">
							<div>
								<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Proof</p>
								<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Experience Timeline</h2>
							</div>
						</div>
						<div class="space-y-0 border-l border-gray-200 dark:border-gray-800">
							{experiences.map((exp) => (
								<article class="relative pb-10 pl-7">
												<span class="absolute -left-1.25 top-1 h-2.5 w-2.5 bg-brandBlue"></span>
									<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
										<div>
											<h3 class="text-2xl font-bold leading-tight">{exp.role}</h3>
											<p class="mt-1 text-sm font-semibold text-brandBlue">{exp.org}</p>
											<p class="text-xs text-gray-400">{exp.location}</p>
										</div>
										<div class="sm:text-right">
											<p class="text-xs font-bold tracking-widest text-gray-400 uppercase">{exp.period}</p>
											{exp.current && <span class="mt-2 inline-block bg-brandBlue px-3 py-1 text-xs font-bold text-white">Current</span>}
										</div>
									</div>
									<ul class="mt-4 grid gap-2 text-sm leading-6 text-gray-700 dark:text-gray-300">
										{exp.highlights.map((highlight) => (
											<li>• {highlight}</li>
										))}
									</ul>
									<div class="mt-4 flex flex-wrap gap-2">
										{exp.tags.map((tag) => (
											<span class="border border-gray-300 px-2 py-1 text-xs text-gray-600 dark:border-gray-700 dark:text-gray-400">{tag}</span>
										))}
									</div>
								</article>
							))}
						</div>
					</section>

					<section id="projects">
						<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Execution</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Technical Project Work</h2>
						<div class="mt-6 grid gap-5">
							{projects.map((project) => (
								<article class="border border-gray-200 p-5 transition hover:border-brandBlue dark:border-gray-800">
									<h3 class="text-xl font-bold">{project.title}</h3>
									<p class="mt-3 text-gray-600 dark:text-gray-300">{project.summary}</p>
									<p class="mt-3 text-sm text-gray-500 dark:text-gray-400"><strong>Outcome:</strong> {project.outcome}</p>
									<div class="mt-4 flex flex-wrap gap-2">
										{project.stack.map((item) => (
											<span class="border border-gray-300 px-2 py-1 text-xs text-gray-600 dark:border-gray-700 dark:text-gray-400">{item}</span>
										))}
									</div>
									{project.liveUrl && (
										<div class="mt-4">
											<ProjectPreview url={project.liveUrl} />
										</div>
									)}
								</article>
							))}
						</div>
					</section>

					<section id="tech-stack">
						<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Tech Stack</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Tools I Use</h2>
						<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
							<div class="space-y-2">
								<p class="font-semibold">Primary</p>
								<ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300">
									<li>Node.js (current)</li>
									<li>TypeScript</li>
									<li>Astro</li>
									<li>Tailwind CSS</li>
								</ul>
							</div>
							<div class="space-y-2">
								<p class="font-semibold">Also familiar with</p>
								<ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300">
									<li>Next.js</li>
									<li>Postgres / Neon</li>
									<li>WordPress (migration & integration)</li>
									<li>Drizzle ORM</li>
								</ul>
							</div>
						</div>
					</section>

					<section id="capabilities" class="grid gap-8 lg:grid-cols-2">
						<div>
							<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Capabilities</p>
							<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Core Competencies</h2>
							<div class="mt-6 grid gap-2">
								{skills.map((skill) => (
									<p class="border-b border-gray-200 py-2 text-sm font-medium dark:border-gray-800">{skill}</p>
								))}
							</div>
						</div>
						<div>
							<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Writing</p>
							<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Human Logic</h2>
							<p class="mt-6 text-gray-600 dark:text-gray-300">
								My writing explains why systems behave the way they do, not just what they do. This improves trust, onboarding, and design quality.
							</p>
							<ul class="mt-5 grid gap-2 text-sm text-gray-700 dark:text-gray-300">
								{writingCapabilities.map((capability) => (
									<li>• {capability}</li>
								))}
							</ul>
						</div>
					</section>

					<section id="education">
						<p class="text-xs font-bold tracking-[0.22em] text-brandBlue uppercase">Foundation</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight uppercase">Education</h2>
						<div class="mt-6 grid gap-4 md:grid-cols-2">
							{education.map((edu) => (
								<article class="border border-gray-200 p-5 dark:border-gray-800">
									<h3 class="text-lg font-bold">{edu.institution}</h3>
									<p class="mt-1 text-brandBlue">{edu.degree || edu.program}</p>
									<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{edu.period}</p>
									{edu.focus && <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">{edu.focus}</p>}
								</article>
							))}
						</div>
					</section>
				</div>
			</div>

			<section class="border-2 border-brandBlue bg-brandBlue/5 p-8 text-center dark:bg-brandBlue/10">
				<h3 class="text-2xl font-bold">Let's Collaborate</h3>
				<p class="mt-2 text-gray-600 dark:text-gray-400">
					Interested in discussing systems design, reflective models, or ethical technology?
				</p>
				<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
					<a
						href="mailto:danieladeniji001@gmail.com"
						class="ui-btn ui-btn-primary"
					>
						Email Me
					</a>
					<a
						href="https://www.linkedin.com/in/adeyemi-adeniji-828204253/"
						target="_blank"
						rel="noreferrer"
						class="ui-btn ui-btn-secondary"
					>
						LinkedIn
					</a>
				</div>
				<p class="mt-4 text-sm text-gray-700 dark:text-gray-300">Direct email: <a href="mailto:danieladeniji001@gmail.com" class="font-semibold text-brandBlue underline underline-offset-4">danieladeniji001@gmail.com</a></p>
			</section>
		</main>

		<Footer />

		<div class="mobile-contact-chip md:hidden">
			<a href="mailto:danieladeniji001@gmail.com" class="ui-btn ui-btn-primary">Email</a>
			<a href="https://linktr.ee/_adeyemiadeniji" target="_blank" rel="noreferrer" class="ui-btn ui-btn-neutral">Linktree</a>
		</div>

		<script is:inline>
			const themeToggle = document.getElementById('themeToggle');
			const mobileMenuToggle = document.getElementById('mobileMenuToggle');
			const mobileMenu = document.getElementById('mobileMenu');

			const initRevealAnimations = () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion) return;
				const revealTargets = Array.from(document.querySelectorAll('main section, .rounded-2xl, footer'));
				revealTargets.forEach((node) => node.classList.add('reveal-up'));
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.14, rootMargin: '0px 0px -10% 0px' },
				);
				revealTargets.forEach((node) => observer.observe(node));
			};

			mobileMenuToggle?.addEventListener('click', () => {
				if (!mobileMenu) return;
				mobileMenu.classList.toggle('hidden');
				mobileMenu.classList.toggle('grid');
			});

			document.querySelectorAll('.mobile-nav-link').forEach((link) => {
				link.addEventListener('click', () => {
					if (!mobileMenu) return;
					mobileMenu.classList.add('hidden');
					mobileMenu.classList.remove('grid');
				});
			});

			if (themeToggle) {
				themeToggle.addEventListener('click', () => {
					const element = document.documentElement;
					element.classList.toggle('dark');
					const isDark = element.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
			}

			initRevealAnimations();
		</script>
	</body>
</html>
