---
import ProjectCard from '../components/work/ProjectCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
---

<SiteLayout title="Work" description="Selected software products, websites, and professional work by Adeyemi Adeniji." canonicalPath="/work">
    <header class="page-intro">
        <div class="site-container page-intro__grid">
            <div><p class="eyebrow">Work · Selected evidence</p><h1>Digital products, built with a clear role.</h1></div>
            <p class="page-intro__lead">What each project is, why it exists, and what I contributed—without borrowing ownership or inflating outcomes.</p>
        </div>
    </header>

    <section class="page-section" aria-labelledby="projects-heading">
        <div class="site-container">
            <div class="section-heading" data-reveal>
                <div><p class="eyebrow">Selected projects</p><h2 id="projects-heading">Five pieces of work. Three lead.</h2></div>
                <p>RILayer, the SCP website, and SCOPE carry the strongest weight. Supporting projects remain visible without pretending every project is equal.</p>
            </div>
            <div class="project-list">
                {projects.sort((a, b) => a.order - b.order).map((project) => <ProjectCard project={project} featured={project.featured} />)}
            </div>
        </div>
    </section>

    <section class="page-section" aria-labelledby="experience-heading">
        <div class="site-container">
            <div class="section-heading" data-reveal>
                <div><p class="eyebrow">Experience</p><h2 id="experience-heading">Professional context.</h2></div>
                <p>A concise timeline. Related project records above hold the detailed contribution.</p>
            </div>
            <div class="experience-list">
                {experience.map((item) => (
                    <article class="experience-item" data-reveal>
                        <div>
                            <h3>{item.organization}</h3>
                            <p class="experience-item__role">{item.role}</p>
                            {item.officialTitle && <p class="experience-item__title">Official title: {item.officialTitle}</p>}
                        </div>
                        <p class="experience-item__summary">{item.plainLanguageSummary}</p>
                        <p class="experience-item__period">{item.period}{item.location && <><br />{item.location}</>}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="page-section page-section--compact" aria-labelledby="technology-heading">
        <div class="site-container split-grid" data-reveal>
            <div class="prose"><p class="eyebrow">Technology</p><h2 id="technology-heading">Tools, attached to evidence.</h2></div>
            <p class="page-intro__lead">Next.js for RILayer. Astro for the rebuilt SCP website. JavaScript and progressive-web-app features for My Student OS. The project records above keep the tools beside the work they support.</p>
        </div>
    </section>
</SiteLayout>
