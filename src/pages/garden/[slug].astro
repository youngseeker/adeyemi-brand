---
import { createHash, randomUUID } from 'node:crypto';
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import { formatReadingMinutes, readingMinutesFromDocument } from '../../lib/readingTime';
import { isPubliclyVisiblePost } from '../../lib/postVisibility';
import { getIpHash, getPollResults } from '../../lib/polls';
import PwaHead from '../../components/PwaHead.astro';
import '../../styles/global.css';

const { slug } = Astro.params;

const prettyTitle = (value: string) =>
    value
        .split('-')
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');

const derivePostTitle = (value: unknown, fallbackSlug?: string) => {
    if (typeof value === 'string' && value.trim()) return value.trim();
    if (fallbackSlug) return prettyTitle(fallbackSlug);
    return 'Post';
};

const resolveImageSrc = (image: unknown): string | null => {
    if (!image) return null;
    if (typeof image === 'string') return image;
    if (typeof image === 'object' && image !== null && 'src' in image) {
        const src = (image as { src?: unknown }).src;
        if (typeof src === 'string') return src;
    }
    return null;
};

const formatDate = (value: unknown): string => {
    if (value instanceof Date && !Number.isNaN(value.getTime())) {
        return value.toISOString().slice(0, 10);
    }
    if (typeof value === 'string') return value;
    return '';
};

type PollDefinition = {
    key: string;
    question: string;
    options: string[];
};

const slugifyValue = (value: string) =>
    value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

const parsePollDefinitions = (body: string): PollDefinition[] => {
    if (!body) return [];
    const commentPattern = /\{\/\*\s*POLL:\s*([\s\S]*?)\*\/\}/gi;
    const matches = Array.from(body.matchAll(commentPattern));
    return matches
        .map((match, index) => {
            const raw = (match[1] || '').trim();
            if (!raw) return null;
            const lines = raw
                .split(/\r?\n/)
                .map((line) => line.trim())
                .filter(Boolean);
            if (!lines.length) return null;

            const questionLine = lines[0].replace(/^POLL:\s*/i, '').trim();
            const optionsLine = lines.find((line) => /^options?:/i.test(line));
            const options = optionsLine
                ? optionsLine
                    .replace(/^options?:\s*/i, '')
                    .split(',')
                    .map((option) => option.trim())
                    .filter(Boolean)
                : [];

            if (!questionLine || options.length < 2) return null;
            return {
                key: `poll-${slugifyValue(questionLine).slice(0, 48) || index + 1}`,
                question: questionLine,
                options,
            };
        })
        .filter((item): item is PollDefinition => Boolean(item));
};

const rawPosts = await getCollection('posts');
const post = slug ? rawPosts.find((entry) => entry.id === slug) ?? null : null;
const previewRequested = Astro.url.searchParams.get('preview') === '1';

const hashSecret = (secret: string) => createHash('sha256').update(secret).digest('hex');
const DEV_FALLBACK_ADMIN_PASSWORD = 'dev-admin-pass';
const configuredAdminPassword = import.meta.env.ADMIN_PAGE_PASSWORD || '';
const adminPassword = configuredAdminPassword || (import.meta.env.DEV ? DEV_FALLBACK_ADMIN_PASSWORD : '');
const expectedSession = adminPassword ? hashSecret(adminPassword) : '';
const sessionCookie = Astro.cookies.get('admin_session')?.value || '';
const canPreviewUnpublished = previewRequested && Boolean(expectedSession) && sessionCookie === expectedSession;

const canonicalUrl = typeof post?.data.canonicalUrl === 'string' ? post.data.canonicalUrl : '';
const noIndex = Boolean(post?.data.noIndex);
const isPublicVisible = post
    ? isPubliclyVisiblePost({
            status: post.data.status,
            scheduledFor: post.data.scheduledFor,
            publishedAt: post.data.publishedAt,
        })
    : false;
const canViewPost = Boolean(post) && (isPublicVisible || canPreviewUnpublished);
const isUnpublishedPreview = canPreviewUnpublished && !isPublicVisible;

if (!canViewPost) {
    Astro.response.status = 404;
}

const title = derivePostTitle(post?.data.title, slug);

// Use Astro's native MDX renderer to get the Content component and headings
const { Content, headings } = post ? await render(post) : { Content: null, headings: [] };

const articleHeadings = headings || [];
const pollDefinitions = parsePollDefinitions(post?.body || '');

const pollVisitorCookie = 'poll_visitor_id';
const existingPollVisitorId = Astro.cookies.get(pollVisitorCookie)?.value;
const pollVisitorId = existingPollVisitorId && existingPollVisitorId.trim() ? existingPollVisitorId : randomUUID();
if (!existingPollVisitorId) {
    Astro.cookies.set(pollVisitorCookie, pollVisitorId, {
        httpOnly: true,
        secure: !import.meta.env.DEV,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 365,
    });
}
const pollVisitorHeaders = new Headers(Astro.request.headers);
pollVisitorHeaders.set('x-poll-visitor-id', pollVisitorId);
const pollState = post ? await getPollResults(post.id, getIpHash(pollVisitorHeaders)) : { enabled: false as const, results: [] };
const pollStateJson = JSON.stringify(pollState);
void pollStateJson;
const readingLabel = formatReadingMinutes(readingMinutesFromDocument(post?.body || ''));
const coverImageSrc = resolveImageSrc(post?.data.coverImage);
const currentTags = new Set((post?.data.tags || []).map((tag) => tag.toLowerCase()));

const relatedCandidates = rawPosts
    .filter(
        (entry) =>
            entry.id !== slug &&
            isPubliclyVisiblePost({
                status: entry.data.status,
                scheduledFor: entry.data.scheduledFor,
                publishedAt: entry.data.publishedAt,
            }),
    )
    .map((entry) => {
        const candidateTags = (entry.data.tags || []).map((tag) => tag.toLowerCase());
        const sharedTagCount = candidateTags.filter((tag) => currentTags.has(tag)).length;
        return {
            slug: entry.id,
            title: derivePostTitle(entry.data.title, entry.id),
            excerpt: entry.data.excerpt || 'Related reading from the Digital Garden.',
            publishedAt: formatDate(entry.data.publishedAt),
            sharedTagCount,
            readingLabel: formatReadingMinutes(readingMinutesFromDocument(entry.body)),
        };
    });

const relatedPosts = relatedCandidates
    .sort((a, b) => {
        if (b.sharedTagCount !== a.sharedTagCount) return b.sharedTagCount - a.sharedTagCount;
        if (!a.publishedAt) return 1;
        if (!b.publishedAt) return -1;
        return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
    })
    .slice(0, 3);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{isUnpublishedPreview ? `[Preview] ${title}` : title} | A.ADENIJI</title>
        <PwaHead />
        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        {(noIndex || isUnpublishedPreview) && <meta name="robots" content="noindex, nofollow" />}
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&family=Playfair+Display:ital,wght@0,400;1,700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    return 'dark';
                }
                return 'light';
            })();

            if (theme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }
        </script>
    </head>
    <body data-slug={slug || ''} data-title={title} class="bg-white text-black dark:bg-[#050505] dark:text-white">
        <div class="fixed top-0 left-0 z-50 h-1 w-full bg-transparent">
            <div id="readingProgressBar" class="h-full w-0 bg-brandBlue transition-[width] duration-150"></div>
        </div>
        <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-12">
            {isUnpublishedPreview && (
                <div class="mb-8 border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-200">
                    Preview mode: this post is not publicly visible yet.
                </div>
            )}
            <div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,740px)_300px] lg:justify-center lg:gap-16">
                <div>
            <nav class="mx-auto flex max-w-6xl items-center justify-between border-b border-gray-200 pb-5 dark:border-gray-800">
                <div class="hidden items-center gap-4 text-[10px] font-bold tracking-[0.18em] uppercase md:flex">
                    <a href="/" class="transition hover:text-brandBlue">Home</a>
                    <a href="/work" class="transition hover:text-brandBlue">Work</a>
                    <a href="/garden" class="transition hover:text-brandBlue">Articles</a>
                    <a href="/about" class="transition hover:text-brandBlue">About</a>
                </div>
                <div class="flex items-center gap-2">
                    <button id="mobileMenuToggle" type="button" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle mobile navigation menu" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-bold tracking-widest uppercase md:hidden dark:border-gray-700">Menu</button>
                    <button
                        id="themeToggle"
                        type="button"
                        aria-label="Toggle theme"
                        class="flex h-10 w-10 items-center justify-center border border-gray-200 bg-white dark:border-gray-700 dark:bg-black"
                    >
                        <span class="text-xs font-bold uppercase dark:hidden">L</span>
                        <span class="hidden text-xs font-bold uppercase dark:inline">D</span>
                    </button>
                </div>
            </nav>
            <div id="mobileMenu" aria-hidden="true" class="mx-auto hidden max-w-6xl gap-2 border-t border-gray-200 px-6 py-3 text-xs font-bold tracking-[0.2em] uppercase md:hidden dark:border-gray-800">
                <a href="/work" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Work</a>
                <a href="/garden" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Articles</a>
                <a href="/devotionals" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">Devotionals</a>
                <a href="/about" class="mobile-nav-link rounded-md px-2 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-900">About</a>
            </div>
            <header class="pt-8 sm:pt-10">
                <h1 class="max-w-none text-3xl font-bold leading-[1.08] tracking-tight sm:max-w-[11ch] sm:text-5xl md:text-6xl">{title}</h1>
                <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-gray-200 py-3 text-[11px] font-bold tracking-[0.18em] text-gray-500 uppercase dark:border-gray-800 dark:text-gray-400">
                    {post?.data.author && <span>Written by {post.data.author}</span>}
                    {post?.data.publishedAt && <span>{formatDate(post.data.publishedAt)}</span>}
                    <span>{readingLabel}</span>
                    <span id="articleViewsLabel">Views loading...</span>
                </div>
                {post?.data.tags && post.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                            <span class="text-xs font-semibold text-brandBlue underline decoration-brandBlue/30 underline-offset-4">
                                {tag}
                            </span>
                        ))}
                    </div>
                )}
                {post?.data.excerpt && <p class="mt-6 text-lg leading-relaxed text-gray-600 sm:mt-8 sm:text-xl dark:text-gray-300">{post.data.excerpt}</p>}
            </header>
            {coverImageSrc && (
                <figure class="mt-8 overflow-hidden border border-gray-200 bg-white dark:border-gray-800 dark:bg-black">
                    <img src={coverImageSrc} alt={title} class="h-auto w-full object-cover" loading="lazy" />
                        {post?.data.coverImageCredit && (
                            <figcaption class="border-t border-gray-200 px-4 py-2 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
                                Image credit: {post.data.coverImageCredit}
                                {post.data.coverImageCreditUrl && (
                                    <>
                                        {' '}
                                        <a href={post.data.coverImageCreditUrl} class="text-brandBlue underline underline-offset-4">Source</a>
                                    </>
                                )}
                            </figcaption>
                        )}
                </figure>
            )}

            {articleHeadings.length > 0 && (
                <nav class="mt-6 flex flex-wrap gap-2 pb-1 lg:hidden" aria-label="Article sections">
                    {articleHeadings.map((heading) => (
                        <a href={`#${heading.slug}`} class="max-w-full border border-gray-200 bg-white px-3 py-1 text-xs leading-5 text-gray-600 transition hover:border-brandBlue hover:text-brandBlue dark:border-gray-700 dark:bg-black dark:text-gray-300">
                            {heading.text}
                        </a>
                    ))}
                </nav>
            )}

            <div class="article-reading-surface mt-10 sm:mt-12">
                {Content ? (
                    <div class="article-content text-[1.08rem] leading-[1.95] text-gray-800 dark:text-gray-200 sm:text-[1.12rem]">
                        <Content />
                    </div>
                ) : (
                    <p>
                        This entry has been created, but full body content is not yet available in public view.
                    </p>
                )}
            </div>

            {pollDefinitions.length > 0 && (
                <section class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-800">
                    <p class="text-[11px] font-bold tracking-[0.22em] text-brandBlue uppercase">Quick Poll</p>
                    <div class="mt-4 space-y-5">
                        {pollDefinitions.map((poll) => (
                            <article class="article-poll border border-gray-200 p-4 dark:border-gray-700" data-poll-key={poll.key}>
                                <h3 class="text-lg font-bold">{poll.question}</h3>
                                <div class="mt-3 grid gap-2" data-poll-options-list>
                                    {poll.options.map((option, optionIndex) => (
                                        <button
                                            type="button"
                                            class="flex w-full items-center justify-between border border-gray-300 px-3 py-2 text-left text-sm transition hover:border-brandBlue dark:border-gray-700"
                                            data-poll-vote
                                            data-poll-option-index={optionIndex}
                                            aria-pressed="false"
                                        >
                                            <span>{option}</span>
                                            <span data-poll-action-label class="text-xs font-semibold text-gray-500">Vote</span>
                                        </button>
                                    ))}
                                </div>
                                <div class="mt-4 space-y-2" data-poll-results>
                                    {poll.options.map((option) => (
                                        <div data-poll-result-row class="space-y-1">
                                            <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                                                <span>{option}</span>
                                                <span data-poll-result-label>0% - 0</span>
                                            </div>
                                            <div class="h-1.5 w-full bg-gray-200 dark:bg-gray-800">
                                                <div data-poll-result-bar class="h-full w-0 bg-brandBlue"></div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                                <p data-poll-status class="mt-3 text-sm text-gray-500 dark:text-gray-300">Cast a vote to see results.</p>
                            </article>
                        ))}
                    </div>
                </section>
            )}

            {pollDefinitions.length > 0 && (
                <script is:inline type="application/json" id="pollDefinitions">{JSON.stringify(pollDefinitions)}</script>
            )}
            <script is:inline type="application/json" id="pollResults">{pollStateJson}</script>

            <script is:inline>
                const pollArticleSlug = document.body.dataset.slug || '';
                const pollDefinitionsElement = document.getElementById('pollDefinitions');
                const pollResultsElement = document.getElementById('pollResults');
                const parseScriptJson = (element, fallback) => {
                    if (!element) return fallback;
                    try {
                        const raw = element.textContent || '';
                        return raw.trim() ? JSON.parse(raw) : fallback;
                    } catch {
                        return fallback;
                    }
                };
                const pollDefinitions = parseScriptJson(pollDefinitionsElement, []);
                const initialPollResults = parseScriptJson(pollResultsElement, { enabled: false, results: [] });
                const pollResultMap = new Map((initialPollResults.results || []).map((result) => [result.pollKey, result]));
                const localPollPrefix = `poll-vote:${pollArticleSlug}:`;
                const safeParseJson = async (response) => {
                    try {
                        return await response.json();
                    } catch {
                        return {};
                    }
                };

                const getLocalVote = (pollKey) => {
                    try {
                        const value = window.localStorage.getItem(`${localPollPrefix}${pollKey}`);
                        const parsed = Number(value);
                        return Number.isInteger(parsed) && parsed >= 0 ? parsed : null;
                    } catch {
                        return null;
                    }
                };

                const setLocalVote = (pollKey, optionIndex) => {
                    try {
                        window.localStorage.setItem(`${localPollPrefix}${pollKey}`, String(optionIndex));
                    } catch {
                        // localStorage may be unavailable in private or restricted contexts.
                    }
                };

                const getPollOptionCount = (pollElement) => {
                    const optionCount = pollElement.querySelectorAll('[data-poll-vote]').length;
                    return Math.max(0, optionCount);
                };

                const createOptimisticResult = (pollElement, pollKey, optionIndex) => {
                    const existing = pollResultMap.get(pollKey);
                    const optionCount = Math.max(getPollOptionCount(pollElement), existing?.counts?.length || 0, optionIndex + 1);
                    const counts = Array.from({ length: optionCount }, (_, index) => Number(existing?.counts?.[index] || 0));
                    const previousVote = typeof existing?.myVoteIndex === 'number' ? existing.myVoteIndex : getLocalVote(pollKey);

                    if (typeof previousVote === 'number' && previousVote !== optionIndex && counts[previousVote] > 0) {
                        counts[previousVote] -= 1;
                    }
                    if (typeof previousVote !== 'number' || previousVote !== optionIndex) {
                        counts[optionIndex] = (counts[optionIndex] || 0) + 1;
                    }

                    const total = counts.reduce((sum, count) => sum + count, 0);
                    return { pollKey, counts, total: Math.max(total, existing?.total || 1), myVoteIndex: optionIndex };
                };

                const refreshPollResults = async () => {
                    if (!pollArticleSlug) return;
                    const response = await fetch(`/api/polls?slug=${encodeURIComponent(pollArticleSlug)}`);
                    if (!response.ok) return;
                    const payload = await safeParseJson(response);
                    if (!payload?.ok || !Array.isArray(payload.results)) return;
                    payload.results.forEach((entry) => {
                        if (entry?.pollKey) pollResultMap.set(entry.pollKey, entry);
                    });
                    document.querySelectorAll('[data-poll-key]').forEach((pollElement) => {
                        const pollKey = pollElement.dataset.pollKey || '';
                        renderPollResults(pollElement, pollResultMap.get(pollKey));
                    });
                };

                const formatPercent = (value) => `${Math.round(value * 100)}%`;
                const renderPollResults = (pollElement, result) => {
                    const rows = pollElement.querySelectorAll('[data-poll-result-row]');
                    const buttons = pollElement.querySelectorAll('[data-poll-vote]');
                    const status = pollElement.querySelector('[data-poll-status]');
                    const total = result?.total || 0;
                    const counts = result?.counts || [];
                    const pollKey = pollElement.dataset.pollKey || '';
                    const localVote = pollKey ? getLocalVote(pollKey) : null;
                    const selectedIndex = typeof result?.myVoteIndex === 'number' ? result.myVoteIndex : localVote;

                    rows.forEach((row, index) => {
                        const count = counts[index] || 0;
                        const percent = total > 0 ? count / total : 0;
                        const label = row.querySelector('[data-poll-result-label]');
                        const bar = row.querySelector('[data-poll-result-bar]');
                        if (label) label.textContent = `${formatPercent(percent)} - ${count}`;
                        if (bar) bar.style.width = `${Math.max(0, Math.min(100, percent * 100))}%`;
                        row.classList.toggle('ring-1', selectedIndex === index);
                        row.classList.toggle('ring-brandBlue', selectedIndex === index);
                        row.dataset.pollSelected = selectedIndex === index ? 'true' : 'false';
                    });

                    buttons.forEach((button) => {
                        button.disabled = false;
                        button.dataset.pollSaving = 'false';
                        const isSelected = selectedIndex !== null && Number(button.dataset.pollOptionIndex) === selectedIndex;
                        button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
                        button.classList.toggle('border-brandBlue', isSelected);
                        button.classList.toggle('bg-brandBlue/10', isSelected);
                        button.classList.toggle('text-brandBlue', isSelected);
                        button.dataset.pollSelected = isSelected ? 'true' : 'false';
                        const voteLabel = button.querySelector('[data-poll-action-label]');
                        if (voteLabel) voteLabel.textContent = isSelected ? 'Selected' : 'Vote';
                    });

                    if (status) {
                        status.textContent = selectedIndex !== null
                            ? `Your vote has been recorded. ${total} total vote${total === 1 ? '' : 's'}.`
                            : `This poll has received ${total} vote${total === 1 ? '' : 's'}.`;
                    }
                };

                if (!pollArticleSlug) {
                    document.querySelectorAll('[data-poll-status]').forEach((status) => {
                        status.textContent = 'Polling is unavailable because this article is missing a slug identifier.';
                    });
                }

                const submitPollVote = async (button) => {
                    if (!(button instanceof HTMLButtonElement) || button.dataset.pollBusy === 'true') return;
                    const pollElement = button.closest('[data-poll-key]');
                    if (!(pollElement instanceof HTMLElement)) return;
                    const pollKey = pollElement.dataset.pollKey || '';
                    const definition = pollDefinitions.find((entry) => entry.key === pollKey);
                    const optionIndex = Number(button.dataset.pollOptionIndex || '-1');
                    const status = pollElement.querySelector('[data-poll-status]');

                    if (!pollArticleSlug || !pollKey || !Number.isInteger(optionIndex) || optionIndex < 0) {
                        if (status) status.textContent = 'This poll is misconfigured. Refresh and try again.';
                        return;
                    }
                    if (definition && optionIndex >= definition.options.length) {
                        if (status) status.textContent = 'This poll option is invalid. Reload the page to sync options.';
                        return;
                    }

                    const pollButtons = pollElement.querySelectorAll('[data-poll-vote]');
                    const optimisticResult = createOptimisticResult(pollElement, pollKey, optionIndex);
                    pollResultMap.set(pollKey, optimisticResult);
                    setLocalVote(pollKey, optionIndex);
                    renderPollResults(pollElement, optimisticResult);
                    if (status) status.textContent = 'Vote selected. Saving...';
                    pollButtons.forEach((node) => {
                        if (node instanceof HTMLButtonElement) {
                            node.dataset.pollBusy = 'true';
                            node.dataset.pollSaving = Number(node.dataset.pollOptionIndex) === optionIndex ? 'true' : 'false';
                            if (Number(node.dataset.pollOptionIndex) === optionIndex) {
                                const voteLabel = node.querySelector('[data-poll-action-label]');
                                if (voteLabel) voteLabel.textContent = 'Saving';
                            }
                        }
                    });

                    try {
                        const response = await fetch('/api/polls', {
                            method: 'POST',
                            headers: { 'content-type': 'application/json' },
                            body: JSON.stringify({ slug: pollArticleSlug, pollKey, optionIndex }),
                        });

                        const data = await safeParseJson(response);
                        if (!response.ok || !data?.ok) throw new Error(data?.error || 'Vote failed');

                        const updatedResult = (data.results || []).find((entry) => entry.pollKey === pollKey);
                        pollResultMap.set(pollKey, updatedResult || optimisticResult);
                        renderPollResults(pollElement, pollResultMap.get(pollKey));
                    } catch (error) {
                        if (status) {
                            const reason = error instanceof Error ? error.message : 'Please retry in a moment.';
                            status.textContent = `Your vote was not submitted. ${reason}`;
                        }
                        await refreshPollResults();
                    } finally {
                        pollButtons.forEach((node) => {
                            if (node instanceof HTMLButtonElement) {
                                node.dataset.pollBusy = 'false';
                                node.dataset.pollSaving = 'false';
                            }
                        });
                        renderPollResults(pollElement, pollResultMap.get(pollKey));
                    }
                };

                document.querySelectorAll('[data-poll-key]').forEach((pollElement) => {
                    const pollKey = pollElement.dataset.pollKey || '';
                    renderPollResults(pollElement, pollResultMap.get(pollKey));
                });

                document.addEventListener('click', (event) => {
                    const button = event.target instanceof Element ? event.target.closest('[data-poll-vote]') : null;
                    if (button) {
                        event.preventDefault();
                        submitPollVote(button);
                    }
                });

                refreshPollResults().catch(() => {
                    // Keep the server-rendered poll state if refresh fails.
                });
            </script>

            <section class="mt-14 border-t border-gray-200 pt-8 dark:border-gray-800" id="comments">
                <p class="text-[11px] font-bold tracking-[0.22em] text-brandBlue uppercase">Reader Review</p>
                <h2 class="mt-2 text-2xl font-bold">Score this essay</h2>
                <p class="mt-2 text-sm text-gray-500 dark:text-gray-300">Reviews publish immediately and support threaded replies.</p>
                <form id="reviewForm" class="mt-5 space-y-3 rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-black">
                    <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label for="reviewName" class="sr-only">Your name</label>
                                <input id="reviewName" type="text" placeholder="Your name" class="w-full border border-gray-300 bg-white px-4 py-3 text-sm focus:border-brandBlue focus:outline-none dark:border-gray-700 dark:bg-transparent" />
                            </div>
                            <div>
                                <label for="reviewRating" class="sr-only">Rating</label>
                                <select id="reviewRating" class="w-full border border-gray-300 bg-white px-4 py-3 text-sm focus:border-brandBlue focus:outline-none dark:border-gray-700 dark:bg-transparent" required>
                            <option value="">Rating</option>
                            <option value="5">5 - Excellent</option>
                            <option value="4">4 - Great</option>
                            <option value="3">3 - Good</option>
                            <option value="2">2 - Fair</option>
                            <option value="1">1 - Weak</option>
                        </select>
                    </div>
                    <label for="reviewComment" class="sr-only">Review comment</label>
                    <textarea id="reviewComment" placeholder="What did you think?" required rows="4" class="w-full border border-gray-300 bg-white px-4 py-3 text-sm focus:border-brandBlue focus:outline-none dark:border-gray-700 dark:bg-transparent"></textarea>
                    <button type="submit" class="ui-btn ui-btn-primary rounded-none">Submit Review</button>
                </form>
                <p id="reviewStatus" class="mt-3 text-sm text-gray-500 dark:text-gray-300"></p>
            </section>

            <section class="mt-10 border-t border-gray-200 pt-8 dark:border-gray-800">
                <h2 class="text-2xl font-bold">Approved Reviews</h2>
                <div id="approvedReviews" class="mt-4 space-y-3"></div>
            </section>

            {relatedPosts.length > 0 && (
                <section class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-800">
                    <h2 class="text-2xl font-bold">Related Articles</h2>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-300">Continue with connected ideas and references.</p>
                    <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
                        {relatedPosts.map((item) => (
                            <a href={`/garden/${item.slug}`} class="border border-gray-200 bg-white p-4 transition hover:border-brandBlue dark:border-gray-800 dark:bg-black">
                                <p class="text-[10px] tracking-widest text-gray-400 uppercase">{item.publishedAt || 'Digital Garden'} / {item.readingLabel}</p>
                                <h3 class="mt-2 text-lg font-bold">{item.title}</h3>
                                <p class="mt-2 line-clamp-3 text-sm text-gray-600 dark:text-gray-300">{item.excerpt}</p>
                            </a>
                        ))}
                    </div>
                </section>
            )}
                </div>
                <aside class="hidden lg:sticky lg:top-10 lg:block lg:h-fit">
                    <div class="border-l border-gray-200 pl-6 dark:border-gray-800">
                        <p class="text-[10px] font-bold tracking-[0.25em] text-gray-400 uppercase">About the Author</p>
                        <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                            <strong class="text-black dark:text-white">{post?.data.author || 'Adeyemi Adeniji'}</strong> writes about systems, attention, learning, and the practical architecture of better thinking.
                        </p>
                        <a href="/about" class="mt-3 inline-block text-sm font-bold text-brandBlue underline underline-offset-4">Learn more</a>

                        <div class="mt-8 border-t border-gray-200 pt-6 dark:border-gray-800">
                            <p class="text-[10px] font-bold tracking-[0.25em] text-gray-400 uppercase">Reader Signal</p>
                            <button id="likeButton" type="button" class="mt-3 border border-brandBlue px-4 py-2 text-xs font-bold tracking-[0.16em] text-brandBlue uppercase transition hover:bg-brandBlue hover:text-white">Like</button>
                            <p class="mt-2 text-sm"><span id="likeCount" class="font-bold">0</span> likes</p>
                            <p id="reactionStatus" class="mt-2 text-xs text-gray-500 dark:text-gray-300"></p>
                        </div>

                        <div class="mt-8 border-t border-gray-200 pt-6 dark:border-gray-800">
                        <p class="text-[10px] font-bold tracking-[0.25em] text-gray-400 uppercase">In this article</p>
                        {articleHeadings.length > 0 ? (
                            <nav class="mt-3 space-y-2">
                                {articleHeadings.map((heading) => (
                                    <a href={`#${heading.slug}`} class={`toc-link block border-l border-transparent px-3 py-1 text-sm text-gray-600 transition hover:border-brandBlue hover:text-brandBlue dark:text-gray-300 ${heading.depth === 3 ? 'ml-3' : ''}`}>
                                        {heading.text}
                                    </a>
                                ))}
                            </nav>
                        ) : (
                            <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">No section headings yet.</p>
                        )}
                        </div>
                    </div>
                </aside>
            </div>
        </main>

        <script is:inline>
            const pageBody = document.body;
            const articleSlug = pageBody?.dataset.slug || '';
            const articleTitle = pageBody?.dataset.title || 'Post';
            const supportEmail = 'danieladeniji001@gmail.com';

            const themeToggle = document.getElementById('themeToggle');
            if (themeToggle) {
                themeToggle.addEventListener('click', () => {
                    const element = document.documentElement;
                    element.classList.toggle('dark');
                    const isDark = element.classList.contains('dark');
                    localStorage.setItem('theme', isDark ? 'dark' : 'light');
                });
            }

            const reviewForm = document.getElementById('reviewForm');
            const reviewStatus = document.getElementById('reviewStatus');
            const approvedReviews = document.getElementById('approvedReviews');
            const likeButton = document.getElementById('likeButton');
            const likeCount = document.getElementById('likeCount');
            const reactionStatus = document.getElementById('reactionStatus');
            const articleViewsLabel = document.getElementById('articleViewsLabel');

            const slugifyHeading = (value) =>
                String(value || '')
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');

            const assignHeadingIds = () => {
                const used = new Map();
                document.querySelectorAll('.article-content h2, .article-content h3').forEach((heading) => {
                    const text = heading.textContent || '';
                    if (!text.trim()) return;
                    const base = slugifyHeading(text);
                    if (!base) return;
                    const seen = used.get(base) || 0;
                    used.set(base, seen + 1);
                    heading.id = seen === 0 ? base : `${base}-${seen + 1}`;
                });
            };

            const styleReferenceLists = () => {
                const splitInlineReferences = (text) => {
                    const cleaned = String(text || '').replace(/\s+/g, ' ').trim();
                    if (!cleaned) return [];
                    const segments = cleaned
                        .split(/(?:^|\s)(?:\[\d+\]|\d+\.|â€¢)\s+/g)
                        .map((item) => item.trim())
                        .filter((item) => item.length > 8);
                    if (segments.length >= 2) {
                        return segments.map((item) => (/[.!?]$/.test(item) ? item : `${item}.`));
                    }
                    return [];
                };

                document.querySelectorAll('.article-content h2, .article-content h3').forEach((heading) => {
                    const title = (heading.textContent || '').trim().toLowerCase();
                    if (!/^(references|bibliography|citations|sources)$/.test(title)) return;

                    const createReferenceList = (entries) => {
                        const list = document.createElement('ol');
                        list.className = 'references-list';
                        entries.forEach((entry) => {
                            const li = document.createElement('li');
                            li.textContent = String(entry || '').trim();
                            list.appendChild(li);
                        });
                        return list;
                    };

                    let cursor = heading.nextElementSibling;
                    const betweenNodes = [];
                    while (cursor && !cursor.matches('h1, h2, h3, h4, h5, h6')) {
                        betweenNodes.push(cursor);
                        cursor = cursor.nextElementSibling;
                    }

                    if (!betweenNodes.length) return;

                    const explicitOrderedList = betweenNodes.find((node) => node.matches('ol'));
                    if (explicitOrderedList) {
                        explicitOrderedList.classList.add('references-list');
                        return;
                    }

                    const explicitUnorderedList = betweenNodes.find((node) => node.matches('ul'));
                    if (explicitUnorderedList) {
                        const items = Array.from(explicitUnorderedList.querySelectorAll('li'))
                            .map((li) => (li.textContent || '').trim())
                            .filter(Boolean);
                        if (items.length) {
                            const normalized = createReferenceList(items);
                            explicitUnorderedList.replaceWith(normalized);
                            betweenNodes.forEach((node) => {
                                if (node !== explicitUnorderedList) node.remove();
                            });
                            return;
                        }
                    }

                    const aggregateText = betweenNodes
                        .map((node) => (node.textContent || '').trim())
                        .filter(Boolean)
                        .join(' ');
                    if (!aggregateText || aggregateText.length < 80) return;

                    const entries = splitInlineReferences(aggregateText);
                    if (entries.length >= 2) {
                        const normalized = createReferenceList(entries);
                        betweenNodes[0].replaceWith(normalized);
                        betweenNodes.slice(1).forEach((node) => node.remove());
                    }
                });
            };

            const normalizeFootnotePlacement = () => {
                const isStandaloneRefParagraph = (paragraph) => {
                    if (!(paragraph instanceof HTMLParagraphElement)) return false;
                    const hasReference = paragraph.querySelector('.article-footnote-inline, .article-footnote-ref, sup, a[href^="#fn"]');
                    if (!hasReference) return false;
                    const cleanedText = (paragraph.textContent || '').replace(/\s+/g, ' ').trim();
                    return cleanedText.length <= 4;
                };

                document.querySelectorAll('.article-content p').forEach((paragraph) => {
                    if (!isStandaloneRefParagraph(paragraph)) return;
                    const previous = paragraph.previousElementSibling;
                    if (!(previous instanceof HTMLParagraphElement)) return;

                    const referenceNode = paragraph.querySelector('.article-footnote-inline, .article-footnote-ref, sup, a[href^="#fn"]');
                    if (!referenceNode) return;

                    const trailingNode = previous.lastChild;
                    if (trailingNode && trailingNode.nodeType === Node.TEXT_NODE) {
                        trailingNode.textContent = (trailingNode.textContent || '').replace(/\s+$/g, '');
                    }

                    previous.appendChild(referenceNode);
                    paragraph.remove();
                });

                document.querySelectorAll('.article-content .article-footnote-inline').forEach((node) => {
                    const previous = node.previousSibling;
                    if (previous && previous.nodeType === Node.TEXT_NODE) {
                        previous.textContent = (previous.textContent || '').replace(/\s+$/g, '');
                    }
                });
            };

            const updateReadingProgress = () => {
                const bar = document.getElementById('readingProgressBar');
                if (!bar) return;
                const article = document.querySelector('.article-content');
                if (!article) return;
                const rect = article.getBoundingClientRect();
                const total = Math.max(1, rect.height - window.innerHeight * 0.4);
                const progressed = Math.min(total, Math.max(0, -rect.top + window.innerHeight * 0.2));
                const pct = Math.max(0, Math.min(100, (progressed / total) * 100));
                bar.style.width = `${pct}%`;
            };

            const cursorHeadings = () => {
                const headings = Array.from(document.querySelectorAll('.article-content h2[id], .article-content h3[id]'));
                if (!headings.length) return;
                let activeId = headings[0].id;
                headings.forEach((heading) => {
                    const rect = heading.getBoundingClientRect();
                    if (rect.top <= 140) activeId = heading.id;
                });
                document.querySelectorAll('.toc-link').forEach((link) => {
                    const href = link.getAttribute('href') || '';
                    const isActive = href === `#${activeId}`;
                    link.classList.toggle('text-brandBlue', isActive);
                    link.classList.toggle('border-brandBlue', isActive);
                });
            };

            const initCodeHighlighting = async () => {
                const codeNodes = Array.from(document.querySelectorAll('.article-content pre code'));
                if (!codeNodes.length) return;
                try {
                    await import('prismjs');
                    await Promise.all([
                        import('prismjs/components/prism-javascript'),
                        import('prismjs/components/prism-typescript'),
                        import('prismjs/components/prism-python'),
                        import('prismjs/components/prism-bash'),
                        import('prismjs/components/prism-json'),
                        import('prismjs/components/prism-sql'),
                        import('prismjs/components/prism-markup'),
                    ]);
                    const Prism = window.Prism;
                    if (!Prism) return;
                    codeNodes.forEach((node) => Prism.highlightElement(node));
                } catch {
                    // no-op
                }
            };

            const initMermaid = async () => {
                if (!document.querySelector('.article-content .mermaid')) return;
                try {
                    const mermaid = (await import('mermaid')).default;
                    mermaid.initialize({ startOnLoad: false, theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default' });
                    await mermaid.run({ querySelector: '.article-content .mermaid' });
                } catch {
                    // no-op
                }
            };

            const escapeHtml = (value) =>
                String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');

            const loadApprovedReviews = async () => {
                if (!approvedReviews || !articleSlug) return;
                const response = await fetch(`/api/feedback?slug=${encodeURIComponent(articleSlug)}`);
                if (!response.ok) {
                    approvedReviews.innerHTML = '<p class="text-gray-500">Unable to load reviews.</p>';
                    return;
                }
                const payload = await response.json();
                const items = payload.items || [];
                if (!items.length) {
                    approvedReviews.innerHTML = '<p class="text-gray-500">No approved reviews yet.</p>';
                    return;
                }

                // Build a parent -> children map so we can render threaded replies
                const byId = new Map();
                items.forEach((it) => byId.set(String(it.id), { ...it, children: [] }));
                const roots = [];
                items.forEach((it) => {
                    const id = String(it.id);
                    const parent = it.parentId ? String(it.parentId) : null;
                    if (parent && byId.has(parent)) {
                        byId.get(parent).children.push(byId.get(id));
                    } else {
                        roots.push(byId.get(id));
                    }
                });

                const renderItem = (item, depth = 0) => {
                    const indent = depth * 12;
                    const header = `<p class="text-sm font-bold">${escapeHtml(item.name)} / ${'★'.repeat(Number(item.rating || 0))}</p>`;
                    const body = `<p class="mt-2">${escapeHtml(item.comment)}</p>`;
                    const replyBtn = `<button data-review-id="${escapeHtml(item.id)}" class="reply-btn mt-3 text-xs font-semibold text-brandBlue">Reply</button>`;
                    const reactionsHtml = `<div class="mt-3 flex items-center gap-2 comment-reactions" data-comment-id="${escapeHtml(item.id)}"><button data-reaction="like" class="reaction-btn rounded-full border border-gray-300 px-3 py-1 text-xs font-semibold dark:border-gray-700">Like</button><span class="reaction-count text-xs text-gray-500" data-reaction-type="like">${(item.reactions && item.reactions.like) || 0}</span></div>`;
                    const childHtml = (item.children || []).map((c) => renderItem(c, depth + 1)).join('');
                    // include a hidden inline reply form container
                    const replyForm = `<form class="inline-reply-form mt-3 hidden grid gap-2 sm:grid-cols-[1fr_2fr_auto]" data-parent-id="${escapeHtml(item.id)}"><input name="replyName" placeholder="Your name" class="border px-3 py-2 text-sm dark:border-gray-700 dark:bg-transparent" /><input name="replyComment" placeholder="Reply" class="border px-3 py-2 text-sm dark:border-gray-700 dark:bg-transparent" /><button class="ui-btn ui-btn-primary text-xs">Send</button></form>`;
                    return `<article style="margin-left:${indent}px" class="border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-black">${header}${body}${reactionsHtml}${replyBtn}${replyForm}${childHtml}</article>`;
                };

                approvedReviews.innerHTML = roots.map((r) => renderItem(r)).join('');

                // Attach reply handlers and reaction handlers
                approvedReviews.querySelectorAll('.reply-btn').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const id = btn.getAttribute('data-review-id');
                        const form = approvedReviews.querySelector(`.inline-reply-form[data-parent-id="${id}"]`);
                        if (!form) return;
                        form.classList.toggle('hidden');
                    });
                });

                approvedReviews.querySelectorAll('.inline-reply-form').forEach((form) => {
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const parentId = form.getAttribute('data-parent-id');
                        const name = (form.querySelector('input[name="replyName"]') || { value: 'Anonymous' }).value || 'Anonymous';
                        const comment = (form.querySelector('input[name="replyComment"]') || { value: '' }).value || '';
                        if (!comment) return alert('Please enter a reply');
                        try {
                            const resp = await fetch('/api/feedback', {
                                method: 'POST',
                                headers: { 'content-type': 'application/json' },
                                body: JSON.stringify({ slug: articleSlug, title: articleTitle, name, rating: 1, comment, parentId }),
                            });
                            if (!resp.ok) throw new Error('Reply failed');
                            await loadApprovedReviews();
                        } catch (err) {
                            alert('Unable to post reply. Please try again later.');
                        }
                    });
                });

                // Reaction handlers
                approvedReviews.querySelectorAll('.reaction-btn').forEach((btn) => {
                    btn.addEventListener('click', async () => {
                        const commentId = btn.closest('.comment-reactions')?.getAttribute('data-comment-id');
                        const type = btn.getAttribute('data-reaction') || 'like';
                        if (!commentId) return;
                        try {
                            const resp = await fetch('/api/comment-reactions', {
                                method: 'POST',
                                headers: { 'content-type': 'application/json' },
                                body: JSON.stringify({ commentId, type }),
                            });
                            if (!resp.ok) throw new Error('Reaction failed');
                            await loadApprovedReviews();
                        } catch (err) {
                            console.error(err);
                        }
                    });
                });
            };

            reviewForm?.addEventListener('submit', async (event) => {
                event.preventDefault();
                const name = document.getElementById('reviewName');
                const rating = document.getElementById('reviewRating');
                const comment = document.getElementById('reviewComment');

                if (!(name instanceof HTMLInputElement) || !(rating instanceof HTMLSelectElement) || !(comment instanceof HTMLTextAreaElement)) {
                    return;
                }

                const response = await fetch('/api/feedback', {
                    method: 'POST',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({
                        slug: articleSlug,
                        title: articleTitle,
                        name: name.value,
                        rating: Number(rating.value),
                        comment: comment.value,
                    }),
                });

                if (!response.ok) {
                    if (reviewStatus) reviewStatus.textContent = 'Unable to submit review right now.';
                    return;
                }

                let payload = {};
                try {
                    payload = await response.json();
                } catch {
                    payload = {};
                }

                if (reviewStatus) {
                    const status = payload?.item?.status;
                    reviewStatus.textContent = status === 'approved'
                        ? 'Thanks. Your comment is now live.'
                        : 'Thanks. Your comment was saved.';
                }
                reviewForm.reset();
                await loadApprovedReviews();
            });

            const trackView = async () => {
                if (!articleSlug) return;
                const response = await fetch('/api/analytics', {
                    method: 'POST',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({ slug: articleSlug }),
                });
                try {
                    const payload = await response.json();
                    if (articleViewsLabel && typeof payload.views === 'number') {
                        articleViewsLabel.textContent = `${payload.views} view${payload.views === 1 ? '' : 's'}`;
                    }
                } catch {
                    if (articleViewsLabel) articleViewsLabel.textContent = 'Views unavailable';
                }
            };

            const loadViews = async () => {
                if (!articleSlug || !articleViewsLabel) return;
                try {
                    const response = await fetch(`/api/analytics`);
                    if (!response.ok) throw new Error('unavailable');
                    const payload = await response.json();
                    const found = Array.isArray(payload.viewsBySlug) ? payload.viewsBySlug.find((entry) => entry.slug === articleSlug) : null;
                    const count = Number(found?.views || 0);
                    articleViewsLabel.textContent = `${count} view${count === 1 ? '' : 's'}`;
                } catch {
                    articleViewsLabel.textContent = 'Views unavailable';
                }
            };

            const loadReactions = async () => {
                if (!articleSlug) return;
                const response = await fetch(`/api/reactions?slug=${encodeURIComponent(articleSlug)}`);
                if (!response.ok) return;
                const payload = await response.json();
                if (likeCount) likeCount.textContent = String(payload.likes || 0);
                if (reactionStatus && payload.reactionsEnabled === false) {
                    reactionStatus.textContent = 'Reactions are temporarily unavailable. Initialize the reactions table to enable likes.';
                }
                if (likeButton instanceof HTMLButtonElement && payload.reactionsEnabled === false) {
                    likeButton.disabled = true;
                    likeButton.textContent = 'Unavailable';
                    return;
                }
                if (likeButton instanceof HTMLButtonElement && payload.hasLiked) {
                    likeButton.disabled = true;
                    likeButton.textContent = 'Liked';
                }
            };

            likeButton?.addEventListener('click', async () => {
                if (!(likeButton instanceof HTMLButtonElement) || !articleSlug) return;
                likeButton.disabled = true;
                const response = await fetch('/api/reactions', {
                    method: 'POST',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({ slug: articleSlug }),
                });
                if (!response.ok) {
                    if (reactionStatus) reactionStatus.textContent = 'Unable to save your like right now.';
                    likeButton.disabled = false;
                    return;
                }
                const payload = await response.json();
                if (likeCount) likeCount.textContent = String(payload.likes || 0);
                likeButton.textContent = 'Liked';
            });

            const parseJsonSafe = async (response) => {
                try {
                    return await response.json();
                } catch {
                    return {};
                }
            };

            const bindInlineNewsletterForms = () => {
                document.querySelectorAll('[data-inline-newsletter-form]').forEach((form) => {
                    if (!(form instanceof HTMLFormElement)) return;
                    if (form.dataset.bound === 'true') return;
                    form.dataset.bound = 'true';

                    const emailInput = form.querySelector('[data-newsletter-email]');
                    const statusNode = form.querySelector('[data-newsletter-status]');

                    form.addEventListener('submit', async (event) => {
                        event.preventDefault();
                        if (!(emailInput instanceof HTMLInputElement)) return;
                        const email = emailInput.value.trim();
                        if (!email) {
                            if (statusNode) statusNode.textContent = 'Enter your email first.';
                            return;
                        }

                        if (statusNode) statusNode.textContent = 'Submitting...';
                        try {
                            const response = await fetch('/api/newsletter', {
                                method: 'POST',
                                headers: { 'content-type': 'application/json' },
                                body: JSON.stringify({ email }),
                            });
                            const payload = await parseJsonSafe(response);
                            if (!response.ok) {
                                if (statusNode) {
                                    const contact = encodeURIComponent(payload?.contactEmail || supportEmail);
                                    statusNode.innerHTML = `${escapeHtml(payload?.error || 'Unable to subscribe right now.')} <a href="mailto:${contact}" class="font-semibold text-brandBlue underline underline-offset-4">Contact support</a>.`;
                                }
                                return;
                            }

                            emailInput.value = '';
                            if (statusNode) statusNode.textContent = payload?.message || 'Subscribed successfully.';
                        } catch {
                            if (statusNode) {
                                statusNode.innerHTML = `Unable to subscribe right now. <a href="mailto:${supportEmail}" class="font-semibold text-brandBlue underline underline-offset-4">Email us directly</a>.`;
                            }
                        }
                    });
                });
            };

            assignHeadingIds();
            styleReferenceLists();
            normalizeFootnotePlacement();
            bindInlineNewsletterForms();
            initCodeHighlighting();
            initMermaid();
            updateReadingProgress();
            cursorHeadings();
            window.addEventListener('scroll', () => {
                updateReadingProgress();
                cursorHeadings();
            });
            loadViews();
            trackView();
            loadApprovedReviews();
            loadReactions();
        </script>
            <script is:inline define:vars={{}}>
                if (typeof window !== 'undefined') {
                    window.katex = window.katex || undefined;
                }
            </script>
        <Footer />
    </body>
</html>
