# Core runtime
DATABASE_URL=

# Giscus comments/reactions configuration
PUBLIC_GISCUS_ENABLED=false
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_CONTACT_EMAIL=danieladeniji001@gmail.com
PUBLIC_SITE_URL=

# Server-side key for moderation actions in /admin/insights
REVIEW_ADMIN_KEY=

# Review workflow: set to false to require manual approval
AUTO_APPROVE_REVIEWS=true

# Password gate for /admin and /publish routes
ADMIN_PAGE_PASSWORD=

# Optional: enable newsletter emails via SMTP provider (Brevo, SendGrid, Mailgun, Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=A.ADENIJI
SMTP_SECURE=false

# Recommended: protects scheduled cron endpoint (/api/newsletter/dispatch)
# In Vercel, set the same CRON_SECRET environment variable so cron requests include the matching bearer token.
CRON_SECRET=

# Optional release metadata surfaced in admin/publish tooling
PUBLIC_COMMIT_SHA=
PUBLIC_BUILD_LABEL=
