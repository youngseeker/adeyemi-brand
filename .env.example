# Core runtime
DATABASE_URL=

# Giscus comments/reactions configuration
PUBLIC_GISCUS_ENABLED=false
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_CONTACT_EMAIL=danieladeniji001@gmail.com
PUBLIC_SITE_URL=

# Server-side key for moderation actions in /admin/insights
REVIEW_ADMIN_KEY=

# Password gate for /admin, /keystatic, and /publish routes
ADMIN_PAGE_PASSWORD=

# Optional: enable newsletter emails via SMTP provider (Brevo, SendGrid, Mailgun, Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=A.ADENIJI
SMTP_SECURE=false

# Optional: protects scheduled cron endpoint (/api/newsletter/dispatch)
CRON_SECRET=

# Optional release metadata surfaced in /qa
PUBLIC_COMMIT_SHA=
PUBLIC_BUILD_LABEL=

# Keystatic GitHub storage for production writes
# Required in deployed environments if you want /keystatic to save back to the repo
KEYSTATIC_GITHUB_REPO=owner/repo
# Must be at least 32 characters in production when using GitHub storage mode
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
